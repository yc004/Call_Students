<view class="profile-page">
  <view class="profile-account">
    <image wx:if="{{cloudAvatar}}" class="avatar-image" src="{{cloudAvatar}}" mode="aspectFill"></image>
    <view wx:else class="avatar">{{initial}}</view>
    <view class="account-main"><text class="account-name">{{cloudNickname || account.name}}</text><text class="account-role">{{roleText}}</text><view class="subject-tags"><text wx:for="{{subjectTags}}" wx:key="*this">{{item}}</text></view></view>
  </view>

  <view class="profile-section"><text class="profile-section-title">账户与安全</text></view>
  <view class="weui-cells">
    <view class="weui-cell"><view class="weui-cell__hd"><view class="setting-icon security-icon">✓</view></view><view class="weui-cell__bd setting-copy"><text>保持登录</text><text>凭证仅保存在当前微信设备</text></view><view class="weui-cell__ft"><text class="state-text">已开启</text></view></view>
    <view class="weui-cell"><view class="weui-cell__hd"><view class="setting-icon identity-icon">教</view></view><view class="weui-cell__bd setting-copy"><text>登录身份</text><text>{{account.name}} · {{roleText}}</text></view></view>
  </view>

  <view class="profile-section"><text class="profile-section-title">云服务</text><text class="profile-section-note">联网使用呼叫、作业与班级数据；人脸功能仍需与教室处于同一局域网。</text></view>
  <view class="cloud-card">
    <block wx:if="{{!cloudConnected}}">
      <text class="cloud-label">尚未连接云服务</text>
      <text class="cloud-hint">支持账号密码注册/登录、tk 身份密钥注册和微信一键登录。</text>
      <button class="primary cloud-action" bindtap="openCloudAuth">登录 / 注册云服务</button>
    </block>
    <block wx:else>
      <view class="cloud-connected"><view class="cloud-dot"></view><view><text>云服务已连接</text><text>{{cloudServerUrl}}</text></view></view>
      <view class="cloud-id-row"><text>云端用户 ID</text><text>{{cloudUserId}}</text></view>
      <text class="cloud-hint">教室成员关系由教室端和云管理员统一同步，不使用连接密钥建立。</text>
      <button class="primary cloud-action" loading="{{cloudBusy}}" disabled="{{cloudBusy}}" bindtap="refreshCloud">同步账号与教室</button>
      <button class="secondary cloud-action" bindtap="disconnectCloud">断开云服务</button>
    </block>
  </view>
  <button class="weui-btn weui-btn_warn logout" bindtap="logout">退出登录</button>
</view>