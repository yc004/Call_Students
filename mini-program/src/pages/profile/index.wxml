<view class="profile-page mode-{{usageMode}}" style="--mode-color:{{organizationColor}}">
  <view class="profile-account" bindtap="openProfileEditor" hover-class="profile-account-pressed" role="button" aria-label="编辑个人信息">
    <view class="avatar-wrap"><image wx:if="{{profileAvatar && !avatarLoadFailed}}" class="avatar-image" src="{{profileAvatar}}" mode="aspectFit" binderror="onAvatarError"></image><view wx:else class="avatar">{{initial}}</view><view class="avatar-edit">✎</view></view>
    <view class="account-main"><text class="account-name">{{cloudNickname || account.name}}</text><text class="account-role">{{roleText}}</text></view>
    <view class="account-entry"><text>›</text></view>
  </view>

  <view class="profile-info-card">
    <view><text>使用模式</text><text>{{usageMode === 'tob' ? '学校或机构账号' : '个人免费使用'}}</text></view>
    <view wx:if="{{organizationName}}"><text>所属组织</text><text>{{organizationName}}</text></view>
    <view><text>设备身份</text><text class="identity-code">{{connectionId || '尚未生成'}}</text></view>
  </view>
  <view class="profile-menu">
    <button bindtap="showHelp"><text>使用帮助</text><text>›</text></button>
    <button bindtap="showPrivacy"><text>隐私与数据边界</text><text>›</text></button>
    <view><text>小程序版本</text><text>{{versionText}}</text></view>
  </view>

  <button class="weui-btn weui-btn_warn logout" bindtap="logout">退出登录</button>
</view>
