.profile-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 20rpx 32rpx calc(220rpx + env(safe-area-inset-bottom));
  background: #f5f5f5;
  color: #191919;
}
.profile-account {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-height: 160rpx;
  margin: 0;
  padding: 28rpx 8rpx;
  align-items: center;
  border: 0;
  background: transparent;
  text-align: left;
  line-height: normal;
  animation: profile-in 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.profile-account::after {
  border: 0;
}
.profile-account-pressed {
  opacity: 0.7;
}
.avatar-wrap {
  position: relative;
  display: flex;
  flex: 0 0 104rpx;
}
.avatar,
.avatar-image {
  display: flex;
  width: 104rpx;
  height: 104rpx;
  flex-shrink: 0;
  border-radius: 22rpx;
}
.avatar {
  align-items: center;
  justify-content: center;
  background: #07c160;
  color: #fff;
  font-size: 38rpx;
  font-weight: 600;
  animation: avatar-pop 0.46s 0.08s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.avatar-image {
  background: #f2f2f2;
}
.avatar-edit {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  display: flex;
  width: 36rpx;
  height: 36rpx;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #f5f5f5;
  border-radius: 50%;
  background: #07c160;
  color: #fff;
  font-size: 17rpx;
}
.account-main {
  width: 0;
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}
.account-name,
.account-role {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.account-name {
  color: #191919;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.35;
}
.account-role {
  margin-top: 4rpx;
  color: #888;
  font-size: 24rpx;
}
.account-entry {
  display: flex;
  width: 44rpx;
  flex: 0 0 44rpx;
  align-items: center;
  justify-content: flex-end;
  margin-left: 12rpx;
  color: #8a8f98;
}
.account-entry text {
  font-size: 42rpx;
  font-weight: 300;
  line-height: 1;
}
.mode-tob .profile-account {
  border-bottom: 4rpx solid var(--mode-color, #2563eb);
}
.mode-tob .avatar-edit {
  background: var(--mode-color, #2563eb);
}
.weui-btn {
  display: flex;
  width: 100%;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 88rpx;
}
.weui-btn::after {
  border: 0;
}
.weui-btn_warn {
  background: #fa5151;
  color: #fff;
}
.profile-info-card,
.profile-menu {
  overflow: hidden;
  margin-top: 24rpx;
  border-radius: 20rpx;
  background: #fff;
}
.profile-info-card > view,
.profile-menu > view,
.profile-menu > button {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-height: 92rpx;
  align-items: center;
  justify-content: space-between;
  margin: 0;
  padding: 0 26rpx;
  border: 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.07);
  border-radius: 0;
  background: transparent;
  color: #191919;
  font-size: 27rpx;
  line-height: 1.4;
  text-align: left;
}
.profile-info-card > view:last-child,
.profile-menu > view:last-child,
.profile-menu > button:last-child {
  border-bottom: 0;
}
.profile-info-card > view > text:first-child,
.profile-menu > view > text:first-child {
  color: #666;
}
.profile-info-card > view > text:last-child,
.profile-menu > view > text:last-child,
.profile-menu > button > text:last-child {
  max-width: 65%;
  color: #8a8f98;
  font-size: 24rpx;
  text-align: right;
}
.profile-menu > button::after {
  border: 0;
}
.identity-code {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.logout {
  margin: 48rpx 0 32rpx;
}
@keyframes profile-in {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
@keyframes avatar-pop {
  0% {
    opacity: 0;
    transform: scale(0.68) rotate(-7deg);
  }
  70% {
    transform: scale(1.06);
  }
  100% {
    opacity: 1;
    transform: none;
  }
}
@media (prefers-color-scheme: dark) {
  .profile-page {
    background: #111;
    color: rgba(255, 255, 255, 0.9);
  }
  .account-name {
    color: rgba(255, 255, 255, 0.92);
  }
  .account-role {
    color: rgba(255, 255, 255, 0.55);
  }
  .avatar-edit {
    border-color: #111;
  }
  .account-entry {
    color: rgba(255, 255, 255, 0.45);
  }
  .profile-info-card,
  .profile-menu {
    background: #242424;
  }
  .profile-info-card > view,
  .profile-menu > view,
  .profile-menu > button {
    border-color: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.9);
  }
  .profile-info-card > view > text:first-child,
  .profile-menu > view > text:first-child {
    color: rgba(255, 255, 255, 0.68);
  }
  .weui-btn_warn {
    background: #d94b4b;
  }
}
@media (prefers-reduced-motion: reduce) {
  .profile-account,
  .avatar {
    animation: none;
  }
}
