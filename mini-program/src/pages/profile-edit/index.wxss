.edit-page{box-sizing:border-box;min-height:100vh;padding:36rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));background:#f5f5f5;color:#191919}.avatar-section{display:flex;align-items:center;flex-direction:column;padding:30rpx 0 42rpx}.avatar-frame{position:relative;display:flex;width:164rpx;height:164rpx;flex:0 0 164rpx;align-items:center;justify-content:center;border-radius:38rpx;background:#e9f8ef;color:#07a34f;font-size:54rpx;font-weight:650}.avatar-preview{display:block;width:164rpx;height:164rpx;border-radius:38rpx;background:#e9f8ef}.avatar-fallback{display:flex;width:100%;height:100%;align-items:center;justify-content:center}.avatar-trigger{position:absolute;z-index:2;inset:0;width:164rpx;height:164rpx;min-width:0;max-width:none;margin:0;padding:0;border:0;border-radius:38rpx;background:transparent;opacity:0;line-height:normal}.avatar-trigger::after{border:0}.camera-mark{position:absolute;z-index:3;right:-10rpx;bottom:-10rpx;display:flex;width:54rpx;height:54rpx;align-items:center;justify-content:center;border:6rpx solid #f5f5f5;border-radius:50%;background:#07c160;color:#fff;font-size:24rpx;pointer-events:none}.mode-tob .avatar-frame,.mode-tob .avatar-preview{background:#eef3ff;color:var(--mode-color,#2563eb)}.mode-tob .camera-mark,.mode-tob .save-button{background:var(--mode-color,#2563eb)}.avatar-title{margin-top:26rpx;font-size:29rpx;font-weight:600}.avatar-note{margin-top:10rpx;color:#8a8f98;font-size:21rpx;text-align:center}.form-section{overflow:hidden;border-radius:22rpx;background:#fff}.field-row{display:flex;min-height:112rpx;padding:0 26rpx;align-items:center}.field-label{width:130rpx;flex-shrink:0;font-size:28rpx}.name-input{height:92rpx;flex:1;color:#191919;font-size:28rpx;text-align:right}.storage-note{display:flex;gap:18rpx;margin:26rpx 8rpx 0;padding:22rpx;border-radius:18rpx;background:#fff}.storage-icon{display:flex;width:46rpx;height:46rpx;flex:0 0 46rpx;align-items:center;justify-content:center;border-radius:14rpx;background:#e9f8ef;color:#07a34f;font-weight:700}.storage-note text{display:block;font-size:23rpx}.storage-note text:last-child{margin-top:6rpx;color:#8a8f98;font-size:21rpx;line-height:1.5}.organization-note{margin:20rpx 8rpx 0;color:#8a8f98;font-size:21rpx}.save-button{height:92rpx;margin-top:40rpx;border:0;border-radius:20rpx;background:#07c160;color:#fff;font-size:29rpx;font-weight:650;line-height:92rpx}.save-button::after{border:0}.save-button[disabled]{opacity:.55}@media(prefers-color-scheme:dark){.edit-page{background:#111;color:rgba(255,255,255,.92)}.avatar-frame,.avatar-preview{background:#173a29;color:#35d67c}.camera-mark{border-color:#111}.form-section,.storage-note{background:#1e1e1e}.name-input{color:rgba(255,255,255,.92)}.avatar-note,.storage-note text:last-child,.organization-note{color:rgba(255,255,255,.5)}}
