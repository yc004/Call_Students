<view class="edit-page mode-{{usageMode}}" style="--mode-color:{{organizationColor}}">
  <view class="avatar-section">
    <view class="avatar-frame">
      <image wx:if="{{profileAvatar}}" class="avatar-preview" src="{{profileAvatar}}" mode="aspectFit"></image>
      <text wx:else class="avatar-fallback">{{initial}}</text>
      <button class="avatar-trigger" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" aria-label="更换头像"></button>
      <view class="camera-mark">✎</view>
    </view>
    <text class="avatar-title">更换头像</text>
  </view>

  <view class="form-section">
    <view class="field-row"><text class="field-label">用户名</text><input class="name-input" type="text" maxlength="40" value="{{editName}}" bindinput="onNameInput" placeholder="请输入用户名"/></view>
  </view>

  <view class="organization-note" wx:if="{{usageMode === 'tob' && organizationName}}">当前组织：{{organizationName}}</view>

  <button class="save-button" loading="{{profileBusy}}" disabled="{{profileBusy}}" bindtap="saveProfile">保存</button>
</view>
