<view class="edit-page mode-{{usageMode}}" style="--mode-color:{{organizationColor}}">
  <view class="avatar-section">
    <view class="avatar-frame">
      <image wx:if="{{profileAvatar && !avatarLoadFailed}}" class="avatar-preview" src="{{profileAvatar}}" mode="aspectFit" binderror="onAvatarError"></image>
      <text wx:else class="avatar-fallback">{{initial}}</text>
      <button class="avatar-trigger" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" aria-label="更换头像"></button>
      <view class="camera-mark">✎</view>
    </view>
    <text class="avatar-title">更换头像</text>
  </view>

  <view class="form-section">
    <view class="field-row"><text class="field-label">用户名</text><input class="name-input" aria-label="用户名" type="text" maxlength="40" value="{{editName}}" bindinput="onNameInput" placeholder="请输入用户名"/></view>
    <button wx:if="{{usageMode === 'tob'}}" class="setting-row" bindtap="openPasswordEditor" hover-class="setting-row-pressed" aria-label="修改登录密码">
      <text class="field-label">登录密码</text>
      <view class="setting-value"><text>修改密码</text><text class="setting-arrow">›</text></view>
    </button>
    <button wx:if="{{usageMode === 'tob'}}" class="setting-row" bindtap="bindWechat" disabled="{{wechatBound || profileBusy}}" hover-class="setting-row-pressed" aria-label="绑定微信账号">
      <text class="field-label">微信账号</text>
      <view class="setting-value"><text>{{wechatBound ? '已绑定' : '绑定当前微信'}}</text><text wx:if="{{!wechatBound}}" class="setting-arrow">›</text></view>
    </button>
  </view>

  <view class="organization-note" wx:if="{{usageMode === 'tob' && organizationName}}">当前组织：{{organizationName}}</view>

  <button class="save-button" loading="{{profileBusy}}" disabled="{{profileBusy}}" bindtap="saveProfile">保存</button>
</view>
