.preflight-page{position:relative;box-sizing:border-box;display:flex;overflow:auto;min-height:100vh;flex-direction:column;padding:calc(env(safe-area-inset-top) + 80rpx) 48rpx calc(env(safe-area-inset-bottom) + 44rpx);background:#f7f8fa;color:#191919}.ambient{position:absolute;border-radius:50%;filter:blur(8rpx);pointer-events:none}.ambient-one{top:-180rpx;right:-160rpx;width:520rpx;height:520rpx;background:rgba(7,193,96,.1)}.ambient-two{bottom:-220rpx;left:-200rpx;width:560rpx;height:560rpx;background:rgba(87,107,149,.08)}.preflight-main{position:relative;z-index:1;display:flex;flex:1;align-items:center;justify-content:center;flex-direction:column;text-align:center}.connection-visual{position:relative;display:flex;width:250rpx;height:250rpx;align-items:center;justify-content:center;margin-bottom:50rpx}.outer-ring,.middle-ring{position:absolute;border-radius:50%;border:2rpx solid rgba(7,193,96,.18)}.outer-ring{inset:0;animation:ring-pulse 2s ease-in-out infinite}.middle-ring{inset:30rpx;border-color:rgba(7,193,96,.28);animation:ring-pulse 2s .35s ease-in-out infinite}.room-symbol,.success-mark,.error-mark{position:absolute;display:flex;width:132rpx;height:132rpx;align-items:center;justify-content:center;border-radius:38rpx;background:#07c160;color:#fff;font-size:52rpx;font-weight:600;box-shadow:0 22rpx 58rpx rgba(7,193,96,.24)}.success-mark,.error-mark{opacity:0;transform:scale(.65)}.state-success .room-symbol,.state-failed .room-symbol{opacity:0;transform:scale(.65)}.state-success .outer-ring,.state-success .middle-ring{border-color:rgba(7,193,96,.25);animation:none}.state-success .success-mark{opacity:1;transform:scale(1);animation:result-in .42s cubic-bezier(.22,1,.36,1) both}.state-failed .outer-ring,.state-failed .middle-ring{border-color:rgba(250,81,81,.2);animation:none}.state-failed .error-mark{background:#fa5151;opacity:1;transform:scale(1);box-shadow:0 22rpx 58rpx rgba(250,81,81,.2);animation:result-in .42s cubic-bezier(.22,1,.36,1) both}.room-name{max-width:620rpx;overflow:hidden;color:#07a34f;font-size:25rpx;font-weight:500;text-overflow:ellipsis;white-space:nowrap}.state-title{margin-top:18rpx;font-size:42rpx;font-weight:600;letter-spacing:.02em}.state-detail{max-width:590rpx;margin-top:18rpx;color:#888;font-size:25rpx;line-height:1.65}.failure-guide{box-sizing:border-box;width:100%;max-width:620rpx;margin-top:24rpx;padding:22rpx;border:1rpx solid #e2e5e9;border-radius:20rpx;background:#fff;text-align:left}.hotspot-guide{border-color:#f2c27b;background:#fff8e8}.failure-guide-title{display:block;color:#191919;font-size:25rpx;font-weight:600}.failure-guide-copy{display:block;margin-top:10rpx;color:#8a5a13;font-size:22rpx;line-height:1.6}.failure-step{display:grid;grid-template-columns:34rpx minmax(0,1fr);gap:12rpx;margin-top:14rpx;color:#666;font-size:22rpx;line-height:1.55}.failure-step>text:first-child{display:flex;width:32rpx;height:32rpx;align-items:center;justify-content:center;border-radius:50%;background:#e9f8ef;color:#078844;font-size:18rpx}.elapsed{margin-top:18rpx;padding:8rpx 18rpx;border-radius:24rpx;background:#e9f8ef;color:#078844;font-size:21rpx}.preflight-footer{position:relative;z-index:1;display:flex;width:100%;align-items:center;flex-direction:column;margin-top:34rpx}.network-pill{display:flex;align-items:center;padding:14rpx 22rpx;border-radius:30rpx;background:#fff;color:#777;font-size:22rpx}.network-dot{width:13rpx;height:13rpx;margin-right:12rpx;border-radius:50%;background:#07c160}.state-failed .network-dot{background:#fa5151}.retry-button,.back-button{display:flex;width:100%;height:88rpx;align-items:center;justify-content:center;border-radius:16rpx;font-size:29rpx;font-weight:500;line-height:88rpx}.retry-button::after,.back-button::after{border:0}.retry-button{margin-top:28rpx;background:#07c160;color:#fff}.back-button{margin-top:16rpx;background:#fff;color:#191919}.waiting-tip{margin-top:24rpx;color:#aaa;font-size:21rpx}.state-connecting .room-symbol{animation:symbol-breathe 1.8s ease-in-out infinite}@keyframes ring-pulse{0%,100%{opacity:.35;transform:scale(.88)}50%{opacity:1;transform:scale(1)}}@keyframes symbol-breathe{0%,100%{transform:scale(.96)}50%{transform:scale(1.04)}}@keyframes result-in{from{opacity:0;transform:scale(.55) rotate(-8deg)}to{opacity:1;transform:scale(1) rotate(0)}}
@media(prefers-color-scheme:dark){.preflight-page{background:#111;color:rgba(255,255,255,.92)}.ambient-one{background:rgba(7,193,96,.08)}.ambient-two{background:rgba(100,130,190,.08)}.state-detail,.waiting-tip{color:rgba(255,255,255,.5)}.network-pill,.back-button{background:#1e1e1e;color:rgba(255,255,255,.78)}.elapsed{background:#173a29;color:#45d487}}
@media(prefers-reduced-motion:reduce){.outer-ring,.middle-ring,.room-symbol,.success-mark,.error-mark{animation:none!important}}
