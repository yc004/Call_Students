.password-page{box-sizing:border-box;min-height:100vh;padding:36rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));background:#f5f5f5;color:#191919}.password-heading{margin:8rpx 8rpx 24rpx}.password-title{display:block;font-size:34rpx;font-weight:650}.password-note{display:block;margin-top:8rpx;color:#8a8f98;font-size:23rpx;line-height:1.55}.password-form{padding:26rpx;border-radius:22rpx;background:#fff}.field-label{display:block;margin:30rpx 0 14rpx;font-size:27rpx;font-weight:500}.compact-label{margin-top:0}.password-input{box-sizing:border-box;width:100%;height:88rpx;padding:0 24rpx;border:1rpx solid #d8d8d8;border-radius:12rpx;background:#fff;color:#191919;font-size:28rpx}.save-button{height:92rpx;margin-top:40rpx;border:0;border-radius:20rpx;background:var(--mode-color,#2563eb);color:#fff;font-size:29rpx;font-weight:650;line-height:92rpx}.save-button::after{border:0}.save-button[disabled]{opacity:.55}@media(prefers-color-scheme:dark){.password-page{background:#111;color:rgba(255,255,255,.92)}.password-note{color:rgba(255,255,255,.55)}.password-form{background:#1e1e1e}.field-label{color:rgba(255,255,255,.92)}.password-input{border-color:rgba(255,255,255,.14);background:#242424;color:rgba(255,255,255,.92)}}
