.login-page { min-height: 100vh; padding-bottom: calc(env(safe-area-inset-bottom) + 40rpx); background: #f5f5f5; }
.login-content { padding: 32rpx; }
.brand { display: flex; align-items: center; }
.brand-mark { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; border-radius: 14rpx; background: #07c160; color: #fff; font-size: 27rpx; font-weight: 600; }
.brand > view:last-child { margin-left: 16rpx; }
.brand-name { display: block; color: rgba(0,0,0,.9); font-size: 30rpx; font-weight: 600; }
.brand-desc { display: block; margin-top: 4rpx; color: rgba(0,0,0,.4); font-size: 20rpx; }
.mode-tabs { display: flex; margin-top: 32rpx; padding: 6rpx; border-radius: 14rpx; background: #e9edf1; }
.mode-tab { flex: 1; padding: 16rpx 0; text-align: center; color: #667085; font-size: 27rpx; }
.mode-tab.active { border-radius: 10rpx; background: #fff; color: #07c160; font-weight: 600; }
.form-tabs { display: flex; margin-top: 20rpx; gap: 12rpx; }
.form-tab { flex: 1; padding: 14rpx 0; text-align: center; border-radius: 10rpx; color: #667085; font-size: 26rpx; background: #fff; }
.form-tab.active { color: #07c160; font-weight: 600; background: #e9f8ef; }
.panel { margin-top: 20rpx; padding: 28rpx; border-radius: 18rpx; background: #fff; }
.label { display: block; margin: 20rpx 0 10rpx; color: #172033; font-size: 26rpx; font-weight: 500; }
.label:first-child { margin-top: 0; }
.field { height: 84rpx; padding: 0 22rpx; border: 1rpx solid #d8d8d8; border-radius: 12rpx; color: #172033; font-size: 28rpx; background: #fbfcfd; }
.panel .primary, .panel .secondary, .panel .wechat-button { margin-top: 28rpx; }
.wechat-button { background: #07c160; color: #fff; }
.scan-entry { margin-top: 22rpx; }
.avatar-row { display: flex; align-items: center; margin-top: 16rpx; }
.avatar-button { margin: 0; flex: 0 0 auto; background: #eef3fb; color: #34517d; font-size: 24rpx; }
.avatar-preview { width: 88rpx; height: 88rpx; margin-left: 16rpx; border-radius: 50%; }
.privacy-row { display: flex; align-items: flex-start; margin: 24rpx 4rpx 0; color: rgba(0,0,0,.45); font-size: 22rpx; line-height: 1.5; }
.privacy-icon { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 32rpx; height: 32rpx; margin: 0 10rpx 0 0; border-radius: 50%; background: #e9f8ef; color: #07c160; font-size: 18rpx; font-weight: 600; }
@media (prefers-color-scheme: dark) {
  .login-page { background:#111; }
  .brand-name, .label { color: rgba(255,255,255,.92); }
  .brand-desc, .privacy-row { color: rgba(255,255,255,.58); }
  .mode-tabs { background:#222; }
  .mode-tab.active { background:#333; color:#35d67c; }
  .form-tab, .panel { background:#1e1e1e; }
  .form-tab.active { background:#173a29; color:#35d67c; }
  .field { border-color: rgba(255,255,255,.14); color: rgba(255,255,255,.92); background:#292929; }
  .avatar-button { background:#2c3e50; color:#d6e4ff; }
  .privacy-icon { background:#173a29; color:#35d67c; }
}
@media(prefers-reduced-motion:reduce){.brand,.panel,.mode-tab{animation:none}}