page{min-height:100%;background:#f5f6f7;color:#111827}.login-page{box-sizing:border-box;min-height:100vh;padding:calc(env(safe-area-inset-top) + 30rpx) 38rpx calc(env(safe-area-inset-bottom) + 48rpx)}.brand-row{display:flex;align-items:center;gap:18rpx;max-width:720rpx;margin:0 auto 66rpx}.brand-mark{display:flex;width:72rpx;height:72rpx;align-items:center;justify-content:center;border-radius:22rpx;background:#07c160;color:#fff;font-size:34rpx;font-weight:700;box-shadow:0 12rpx 28rpx rgba(7,193,96,.2)}.brand-name,.brand-desc{display:block}.brand-name{font-size:30rpx;font-weight:700}.brand-desc{margin-top:3rpx;color:#8a8f98;font-size:21rpx}.choice-view,.form-view{max-width:720rpx;margin:0 auto}.hero{margin-bottom:38rpx}.eyebrow{display:block;margin-bottom:12rpx;color:#07a957;font-size:24rpx;font-weight:650}.hero-title,.form-title{display:block;font-size:48rpx;font-weight:750;line-height:1.25;letter-spacing:-1rpx}.hero-desc,.form-desc{display:block;margin-top:16rpx;color:#747b87;font-size:25rpx;line-height:1.7}.mode-card{display:flex;box-sizing:border-box;align-items:flex-start;gap:24rpx;margin-top:24rpx;padding:34rpx 28rpx;border:2rpx solid #e5e7eb;border-radius:30rpx;background:#fff;box-shadow:0 12rpx 34rpx rgba(17,24,39,.045);transition:transform .16s ease,border-color .16s ease}.mode-card.personal{border-color:#d8f2e3}.mode-card.organization{border-color:#dce6fb}.mode-pressed{transform:scale(.985)}.mode-icon,.large-icon{display:flex;flex:0 0 auto;align-items:center;justify-content:center;color:#fff;font-weight:700}.mode-icon{width:82rpx;height:82rpx;border-radius:24rpx;font-size:31rpx}.personal .mode-icon,.form-hero.personal .large-icon{background:#07c160}.organization .mode-icon,.form-hero.organization .large-icon{background:#2563eb}.mode-copy{flex:1;min-width:0}.mode-copy>view:first-child{display:flex;align-items:center;gap:12rpx}.mode-copy>view>text{font-size:31rpx;font-weight:700}.mode-copy label{padding:4rpx 10rpx;border-radius:10rpx;background:#f0f2f5;color: