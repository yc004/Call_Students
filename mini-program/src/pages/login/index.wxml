<view class="login-page">
  <view class="login-content">
    <view class="brand"><view class="brand-mark">班</view><view><text class="brand-name">班达教师端</text><text class="brand-desc">班级事务，一触即达</text></view></view>

    <view class="mode-tabs">
      <view class="mode-tab {{mode === 'local' ? 'active' : ''}}" data-mode="local" bindtap="setMode">本地模式</view>
      <view class="mode-tab {{mode === 'cloud' ? 'active' : ''}}" data-mode="cloud" bindtap="setMode">云服务模式</view>
    </view>

    <block wx:if="{{mode === 'local'}}">
      <view class="form-tabs">
        <view class="form-tab {{localTab === 'register' ? 'active' : ''}}" data-tab="register" bindtap="setLocalTab">注册</view>
        <view class="form-tab {{localTab === 'login' ? 'active' : ''}}" data-tab="login" bindtap="setLocalTab">登录</view>
      </view>

      <view class="panel" wx:if="{{localTab === 'register'}}">
        <text class="label">教师姓名</text>
        <input class="field" maxlength="20" placeholder="请输入真实姓名" value="{{localName}}" bindinput="onLocalNameInput" />
        <text class="label">登录账号</text>
        <input class="field" maxlength="40" placeholder="默认同教师姓名" value="{{localLoginName}}" bindinput="onLocalLoginNameInput" />
        <text class="label">密码</text>
        <input class="field" password maxlength="40" placeholder="至少 6 位" value="{{localPassword}}" bindinput="onLocalPasswordInput" />
        <text class="label">确认密码</text>
        <input class="field" password maxlength="40" placeholder="再次输入密码" value="{{localConfirmPassword}}" bindinput="onLocalConfirmInput" />
        <button class="primary" bindtap="registerLocal">注册并进入</button>
      </view>

      <view class="panel" wx:else>
        <text class="label">账号或姓名</text>
        <input class="field" maxlength="40" placeholder="请输入登录账号" value="{{localLoginName}}" bindinput="onLocalLoginNameInput" />
        <text class="label">密码</text>
        <input class="field" password maxlength="40" placeholder="请输入密码" value="{{localPassword}}" bindinput="onLocalPasswordInput" />
        <button class="primary" bindtap="loginLocal">登录</button>
      </view>

      <button class="secondary scan-entry" loading="{{scanning}}" bindtap="scanLogin">扫码登录电脑教师端</button>
    </block>

    <block wx:else>
      <view class="form-tabs">
        <view class="form-tab {{cloudTab === 'register' ? 'active' : ''}}" data-tab="register" bindtap="setCloudTab">注册</view>
        <view class="form-tab {{cloudTab === 'login' ? 'active' : ''}}" data-tab="login" bindtap="setCloudTab">登录</view>
      </view>

      <view class="panel" wx:if="{{cloudTab === 'register'}}">
        <text class="label">服务器地址</text>
        <input class="field" type="text" value="{{cloudServerUrl}}" bindinput="onCloudServerInput" placeholder="https://cloud.example.com" />
        <text class="label">教师身份密钥</text>
        <input class="field" password value="{{cloudKey}}" bindinput="onCloudKeyInput" placeholder="tk_..." />
        <text class="label">登录账号</text>
        <input class="field" maxlength="40" value="{{cloudLoginName}}" bindinput="onCloudLoginNameInput" placeholder="设置云服务登录账号" />
        <text class="label">密码</text>
        <input class="field" password maxlength="40" value="{{cloudPassword}}" bindinput="onCloudPasswordInput" placeholder="至少 10 位" />
        <text class="label">昵称</text>
        <input class="field" type="nickname" maxlength="40" value="{{cloudNickname}}" bindinput="onCloudNicknameInput" placeholder="可沿用微信昵称" />
        <view class="avatar-row">
          <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">选择头像</button>
          <image wx:if="{{cloudAvatar}}" class="avatar-preview" src="{{cloudAvatar}}" mode="aspectFill"></image>
        </view>
        <button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="registerCloud">注册并连接云服务</button>
      </view>

      <view class="panel" wx:else>
        <text class="label">服务器地址</text>
        <input class="field" type="text" value="{{cloudServerUrl}}" bindinput="onCloudServerInput" placeholder="https://cloud.example.com" />
        <text class="label">登录账号</text>
        <input class="field" maxlength="40" value="{{cloudLoginName}}" bindinput="onCloudLoginNameInput" placeholder="云服务登录账号" />
        <text class="label">密码</text>
        <input class="field" password maxlength="40" value="{{cloudPassword}}" bindinput="onCloudPasswordInput" placeholder="云服务密码" />
        <button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="loginCloud">账号密码登录</button>
        <button class="wechat-button" loading="{{busy}}" disabled="{{busy}}" bindtap="wechatLogin">微信一键登录</button>
      </view>

      <button class="secondary scan-entry" loading="{{scanning}}" bindtap="scanLogin">扫码登录电脑教师端</button>
    </block>

    <view class="privacy-row"><view class="privacy-icon">✓</view><text>本地模式数据仅保存在当前微信设备；云模式数据会上传至所选服务器。</text></view>
  </view>
</view>