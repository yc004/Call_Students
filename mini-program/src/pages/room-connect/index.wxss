.shared-page { min-height:100vh; padding:64rpx 36rpx calc(48rpx + env(safe-area-inset-bottom)); background:#f5f5f5; color:#191919; }
.shared-header { display:flex; flex-direction:column; align-items:center; padding:18rpx 20rpx 42rpx; text-align:center; animation:shared-in .38s cubic-bezier(.22,1,.36,1) both; }
.share-badge { display:flex; width:88rpx; height:88rpx; align-items:center; justify-content:center; margin-bottom:24rpx; border-radius:24rpx; background:#07c160; color:#fff; font-size:36rpx; font-weight:600; box-shadow:0 14rpx 34rpx rgba(7,193,96,.2); }
.shared-kicker { color:#07a34f; font-size:24rpx; font-weight:500; }.shared-title { max-width:100%; overflow:hidden; margin-top:12rpx; color:#191919; font-size:44rpx; font-weight:600; text-overflow:ellipsis; white-space:nowrap; }.shared-desc { margin-top:14rpx; color:#888; font-size:25rpx; line-height:1.55; }
.room-card,.identity-card { border-radius:20rpx; background:#fff; }
.room-card { display:flex; align-items:center; min-height:132rpx; padding:24rpx 28rpx; animation:shared-in .4s .06s cubic-bezier(.22,1,.36,1) both; }
.room-mark { display:flex; width:76rpx; height:76rpx; flex:0 0 76rpx; align-items:center; justify-content:center; border-radius:18rpx; background:#e9f8ef; color:#07a34f; font-size:29rpx; font-weight:600; }
.room-info { display:flex; min-width:0; flex:1; flex-direction:column; margin-left:22rpx; }.room-info text:first-child { overflow:hidden; color:#191919; font-size:31rpx; font-weight:500; text-overflow:ellipsis; white-space:nowrap; }.room-info text:last-child { margin-top:7rpx; color:#888; font-size:23rpx; }
.saved-tag { padding:7rpx 14rpx; border-radius:20rpx; background:#e9f8ef; color:#07a34f; font-size:20rpx; }
.identity-card { margin-top:24rpx; padding:4rpx 28rpx; animation:shared-in .4s .1s cubic-bezier(.22,1,.36,1) both; }.identity-row { display:flex; min-height:92rpx; align-items:center; justify-content:space-between; gap:28rpx; }.identity-row + .identity-row { border-top:1rpx solid #ededed; }.identity-row text:first-child { flex:0 0 auto; color:#888; font-size:25rpx; }.identity-row text:last-child { color:#191919; font-size:25rpx; text-align:right; }
.subject-field { padding:24rpx 0 28rpx; border-top:1rpx solid #ededed; }.subject-field>text { display:block; margin-bottom:16rpx; color:#191919; font-size:25rpx; font-weight:500; }.subject-field .required { margin-left:8rpx; color:#fa5151; font-size:20rpx; }.subject-field input { box-sizing:border-box; width:100%; height:84rpx; padding:0 22rpx; border:1rpx solid #d9d9d9; border-radius:14rpx; background:#f7f7f7; color:#191919; font-size:27rpx; }
.connection-panel{display:flex;align-items:center;gap:20rpx;margin-top:24rpx;padding:24rpx 26rpx;border-radius:18rpx;background:#fff;animation:connection-state-in .3s cubic-bezier(.22,1,.36,1) both}.connection-indicator{display:flex;width:56rpx;height:56rpx;flex:0 0 auto;align-items:center;justify-content:center;border-radius:50%;background:#eef3ff}.connection-indicator view{width:17rpx;height:17rpx;border-radius:50%;background:#576b95}.connection-copy{display:flex;min-width:0;flex:1;flex-direction:column}.connection-copy text:first-child{color:#191919;font-size:27rpx;font-weight:600}.connection-copy text:last-child{margin-top:6rpx;color:#888;font-size:22rpx;line-height:1.5}.connection-panel.connecting .connection-indicator view{width:24rpx;height:24rpx;border:4rpx solid #b7c6e6;border-top-color:#576b95;background:transparent;animation:connecting-spin .8s linear infinite}.connection-panel.waiting .connection-indicator{background:#fff4e5}.connection-panel.waiting .connection-indicator view{background:#fa9d3b;animation:waiting-pulse 1.4s ease-in-out infinite}.connection-panel.success .connection-indicator{background:#e9f8ef}.connection-panel.success .connection-indicator view{background:#07c160;animation:success-pop .35s cubic-bezier(.22,1,.36,1)}.connection-panel.failed .connection-indicator{background:#fff0f0}.connection-panel.failed .connection-indicator view{background:#fa5151}@keyframes connecting-spin{to{transform:rotate(360deg)}}@keyframes shared-in{from{opacity:0;transform:translateY(18rpx)}to{opacity:1;transform:none}}@keyframes connection-state-in{from{opacity:0;transform:translateY(10rpx)}to{opacity:1;transform:none}}@keyframes waiting-pulse{0%,100%{opacity:.55;transform:scale(.78)}50%{opacity:1;transform:scale(1)}}@keyframes success-pop{0%{transform:scale(.3)}70%{transform:scale(1.18)}100%{transform:scale(1)}}
.connect-button,.scan-button { display:flex; width:100%; height:88rpx; align-items:center; justify-content:center; margin:32rpx 0 0; border-radius:16rpx; font-size:30rpx; font-weight:500; line-height:88rpx; }.connect-button::after,.scan-button::after { border:0; }.connect-button { background:#07c160; color:#fff; }.connect-button[disabled] { background:#a9dfbf; }.scan-button { margin-top:18rpx; background:#fff; color:#191919; }
.security-note { padding:30rpx 24rpx 0; color:#999; font-size:22rpx; line-height:1.6; text-align:center; }
@media (prefers-color-scheme:dark) {
  .shared-page { background:#111;color:rgba(255,255,255,.9); }.shared-title,.room-info text:first-child,.identity-row text:last-child { color:rgba(255,255,255,.92); }.shared-desc,.room-info text:last-child,.identity-row text:first-child,.security-note { color:rgba(255,255,255,.5); }
  .room-card,.identity-card,.connection-panel,.scan-button { background:#1e1e1e; }.connection-copy text:first-child,.scan-button,.subject-field>text,.subject-field input { color:rgba(255,255,255,.9); }.connection-copy text:last-child{color:rgba(255,255,255,.5)}.room-mark,.saved-tag { background:#173a29;color:#35d67c; }.identity-row + .identity-row,.subject-field { border-color:rgba(255,255,255,.1); }.subject-field input { border-color:rgba(255,255,255,.14); background:#282828; }
}
@media(prefers-reduced-motion:reduce){.shared-header,.room-card,.identity-card,.connection-panel,.connection-panel.connecting .connection-indicator view,.connection-panel.waiting .connection-indicator view,.connection-panel.success .connection-indicator view{animation:none}}
