<view class="page call-page">
  <view class="class-card surface">
    <view class="class-main">
      <text class="class-label">当前教室</text>
      <text class="class-name">{{className || roomName || '尚未选择教室'}}</text>
      <view class="class-status"><view class="status-dot {{status}}"></view><text>{{statusMessage}}</text></view>
    </view>
    <text class="secondary-page-tag">教室功能</text>
  </view>

  <view class="connection-notice {{status}}" wx:if="{{status !== 'online'}}">
    <view class="notice-copy"><text>{{statusMessage}}</text><text>{{statusDetail || '请确认手机和教室电脑处于同一局域网。'}}</text></view>
    <button size="mini" bindtap="reconnect">重试</button>
  </view>

  <block wx:if="{{status === 'online'}}">
    <view class="section-heading"><view><text class="section-title">呼叫内容</text><text class="section-note">可自由编辑，点击学生后发送</text></view></view>
    <view class="message-editor surface">
      <textarea class="message-input" aria-label="大屏呼叫内容" value="{{callText}}" maxlength="100" auto-height placeholder="输入要在教室大屏显示的内容" bindinput="editCallText" confirm-type="done"/>
      <view class="message-tools">
        <view class="message-actions">
          <button class="text-tool name-tool" size="mini" bindtap="insertNameVariable">＋ 学生姓名</button>
          <button class="text-tool clear-tool" size="mini" bindtap="clearCallText" wx:if="{{callText}}">清空</button>
        </view>
        <text class="message-count {{callTextLength >= 90 ? 'near-limit' : ''}}">{{callTextLength}}/100</text>
      </view>
      <view class="variable-hint"><text>{name}</text><text>会在发送时自动替换为所选学生姓名</text></view>
    </view>
    <scroll-view class="template-scroll" scroll-x enhanced show-scrollbar="false">
      <view class="template-row"><button class="template-chip {{callText === item ? 'active' : ''}}" wx:for="{{templates}}" wx:key="*this" data-index="{{index}}" bindtap="useTemplate" hover-class="chip-pressed">{{item}}</button></view>
    </scroll-view>

    <view class="section-heading call-student-heading"><view><text class="section-title">选择学生</text><text class="section-note" wx:if="{{multiSelect}}">勾选多名学生后统一发送</text><text class="section-note" wx:else>共 {{students.length}} 名学生，点击即可呼叫</text></view><button class="multi-toggle {{multiSelect?'active':''}}" bindtap="toggleMultiSelect">{{multiSelect?'取消多选':'多选呼叫'}}</button></view>
    <view class="search-box"><view class="search-icon"></view><input aria-label="搜索学生姓名" placeholder="搜索学生姓名" value="{{query}}" bindinput="search" confirm-type="search"/><text role="button" aria-label="清空搜索" class="search-clear" wx:if="{{query}}" bindtap="clearSearch">×</text></view>
    <view class="selection-tools" wx:if="{{multiSelect}}"><button bindtap="selectVisible">全选当前列表</button><button bindtap="clearSelection" disabled="{{!selectedCount}}">清空选择</button><text>已选 {{selectedCount}} 人</text></view>

    <view class="student-list surface" wx:if="{{filteredStudents.length}}">
      <view role="button" aria-label="{{item.name}}，{{item.sent?'呼叫已发送':(multiSelect?(item.selected?'已选择':'未选择'):'点击呼叫')}}" aria-pressed="{{multiSelect ? item.selected : false}}" class="student-cell {{item.sent ? 'sent' : ''}} {{item.selected ? 'selected' : ''}}" hover-class="cell-hover" hover-stay-time="70" wx:for="{{filteredStudents}}" wx:key="id" data-id="{{item.id}}" bindtap="handleStudentTap">
        <view class="student-avatar">{{item.initial}}</view>
        <view class="student-main"><text class="student-name">{{item.name}}</text><text class="student-desc">{{item.sent?'呼叫已发送':(multiSelect?(item.selected?'已加入批量呼叫':'点击选择这名学生'):'点击发送当前呼叫内容')}}</text></view>
        <view class="call-button {{multiSelect?'check-button':''}}">{{item.sent?'✓':(multiSelect?(item.selected?'✓':''):'呼叫')}}</view>
      </view>
    </view>
    <view class="surface empty" wx:else><view class="empty-mark">人</view><text class="empty-title">没有找到学生</text><text class="empty-desc">请检查输入的姓名。</text></view>
    <view class="batch-call-bar" wx:if="{{multiSelect}}"><view><strong>已选 {{selectedCount}} 人</strong><small>{{selectedCount?'将合并为一条大屏呼叫':'点击学生加入批量呼叫'}}</small></view><button disabled="{{!selectedCount}}" bindtap="callSelected">呼叫已选学生</button></view>
  </block>

  <view class="surface empty unavailable" wx:else>
    <view class="empty-mark offline-symbol">!</view>
    <text class="empty-title">连接教室后即可呼叫</text>
    <text class="empty-desc">微信需要获得本地网络访问权限，校园网络还需允许设备互相访问。</text>
    <button class="primary retry-button" bindtap="reconnect">重新连接</button>
  </view>
</view>
