.call-page { padding-bottom:48rpx; }.secondary-page-tag{padding:7rpx 14rpx;border-radius:20rpx;background:#e9f8ef;color:#07a34f;font-size:21rpx}
.class-card { display: flex; align-items: center; padding: 32rpx; }
.class-main { flex: 1; min-width: 0; }
.class-label { display: block; color: rgba(0, 0, 0, .45); font-size: 23rpx; }
.class-name { display: block; overflow: hidden; margin-top: 6rpx; color: rgba(0, 0, 0, .9); font-size: 38rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.class-status { display: flex; align-items: center; margin-top: 14rpx; color: rgba(0, 0, 0, .5); font-size: 23rpx; }
.switch-room { min-width: 144rpx; height: 64rpx; margin: 0 0 0 24rpx; border-radius: 12rpx; background: #f2f2f2; color: rgba(0, 0, 0, .7); font-size: 24rpx; line-height: 64rpx; }
.connection-notice { display: flex; align-items: center; margin-top: 20rpx; padding: 22rpx 24rpx; border-radius: 16rpx; background: #fff5e8; color: #b06000; }
.connection-notice.offline { background: #fff0f0; color: #cf3c3c; }
.notice-copy { flex: 1; min-width: 0; }
.notice-copy text { display: block; font-size: 25rpx; font-weight: 500; }
.notice-copy text:last-child { overflow: hidden; margin-top: 5rpx; font-size: 21rpx; font-weight: 400; text-overflow: ellipsis; white-space: nowrap; opacity: .8; }
.connection-notice button { height: 56rpx; margin: 0 0 0 20rpx; padding: 0 22rpx; border-radius: 10rpx; background: rgba(255,255,255,.7); color: inherit; font-size: 23rpx; line-height: 56rpx; }
.message-editor { padding: 24rpx; }
.message-input { box-sizing: border-box; width: 100%; min-height: 150rpx; max-height: 280rpx; color: rgba(0,0,0,.9); font-size: 29rpx; line-height: 1.6; }
.message-input::placeholder { color: rgba(0,0,0,.3); }
.message-tools { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid rgba(0,0,0,.08); }
.message-actions { display: flex; align-items: center; gap: 12rpx; }
.text-tool { height: 52rpx; margin: 0; padding: 0 18rpx; border-radius: 10rpx; background: #f2f2f2; color: rgba(0,0,0,.65); font-size: 22rpx; line-height: 52rpx; }
.text-tool::after,.template-chip::after { border: 0; }
.name-tool { background: #e9f8ef; color: #078a46; }
.clear-tool { color: rgba(0,0,0,.45); }
.message-count { color: rgba(0,0,0,.35); font-size: 21rpx; font-variant-numeric: tabular-nums; }
.message-count.near-limit { color: #d98200; }
.variable-hint { display: flex; align-items: center; gap: 10rpx; margin-top: 16rpx; color: rgba(0,0,0,.4); font-size: 21rpx; }
.variable-hint text:first-child { padding: 3rpx 9rpx; border-radius: 7rpx; background: #f2f2f2; color: #07a456; font-family: monospace; font-weight: 600; }
.template-scroll { width: 100%; margin-top: 16rpx; white-space: nowrap; }
.template-row { display: inline-flex; gap: 12rpx; padding-right: 24rpx; }
.template-chip { display: inline-flex; width: auto; height: 60rpx; align-items: center; margin: 0; padding: 0 22rpx; border: 1rpx solid rgba(0,0,0,.08); border-radius: 30rpx; background: #fff; color: rgba(0,0,0,.58); font-size: 23rpx; line-height: 60rpx; }
.template-chip.active { border-color: rgba(7,193,96,.28); background: #e9f8ef; color: #078a46; }
.cell-hover { background: #f7f7f7; }
.student-list { margin-top: 20rpx; }
.student-cell { display: flex; align-items: center; min-height: 112rpx; padding: 18rpx 24rpx; }
.student-cell + .student-cell { border-top: 1rpx solid rgba(0, 0, 0, .08); }
.student-avatar { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: 14rpx; background: #e9f8ef; color: #07c160; font-size: 27rpx; font-weight: 600; }
.student-main { flex: 1; min-width: 0; margin-left: 20rpx; }
.student-name { display: block; color: rgba(0, 0, 0, .9); font-size: 29rpx; font-weight: 500; }
.student-desc { display: block; overflow: hidden; margin-top: 5rpx; color: rgba(0, 0, 0, .45); font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.call-button { display: flex; align-items: center; justify-content: center; width: 104rpx; height: 60rpx; border-radius: 12rpx; background: #f2f2f2; color: #07c160; font-size: 24rpx; font-weight: 500; }
.student-cell.sent { background: #f0faf4; }.student-cell.sent .call-button { background: #07c160; color: #fff; }
.unavailable { margin-top: 24rpx; }.offline-symbol { background: #f2f2f2; color: #8a8a8a; }.retry-button { margin-top: 34rpx; }
@media (prefers-color-scheme: dark) {
  .secondary-page-tag{background:#173a29;color:#35d67c}
  .class-label, .class-status, .message-count, .variable-hint, .student-desc { color: rgba(255,255,255,.55); }
  .class-name, .student-name, .message-input { color: rgba(255,255,255,.92); }
  .switch-room, .text-tool, .call-button, .offline-symbol { background:#2a2a2a; color:rgba(255,255,255,.78); }
  .connection-notice { background:#3b2c17; color:#ffc36b; }.connection-notice.offline { background:#3a2022; color:#ff8d8d; }
  .connection-notice button { background:rgba(255,255,255,.12); }
  .message-tools, .student-cell + .student-cell { border-color:rgba(255,255,255,.1); }
  .message-input::placeholder { color:rgba(255,255,255,.35); }.variable-hint text:first-child { background:#2a2a2a; color:#35d67c; }
  .template-chip { border-color:rgba(255,255,255,.12); background:#242424; color:rgba(255,255,255,.7); }.template-chip.active { background:#173a29; color:#35d67c; }
  .student-avatar { background:#2a2a2a; color:rgba(255,255,255,.65); }.student-avatar.present { background:#173a29; color:#35d67c; }
  .student-cell.sent { background:#142b1e; }.student-cell.sent .call-button { background:#07c160; color:#fff; }
}
