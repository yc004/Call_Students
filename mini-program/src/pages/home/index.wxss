.home-welcome{padding:18rpx 8rpx 32rpx;animation:home-welcome-in .38s cubic-bezier(.22,1,.36,1) both}.welcome-kicker{display:block;color:#07a34f;font-size:24rpx;font-weight:500}.welcome-title{display:block;margin-top:8rpx;color:rgba(0,0,0,.9);font-size:44rpx;font-weight:600;line-height:1.3}.welcome-message{display:block;margin-top:12rpx;color:rgba(0,0,0,.5);font-size:25rpx;line-height:1.55}.bind-guide{display:flex;flex-direction:column;align-items:center;padding:52rpx 38rpx 38rpx;text-align:center}.guide-scan-mark{display:flex;width:112rpx;height:112rpx;align-items:center;justify-content:center;border-radius:28rpx;background:#e9f8ef;color:#07c160;font-size:60rpx;animation:guide-mark-in .55s .12s cubic-bezier(.22,1,.36,1) both}.guide-title{margin-top:28rpx;color:rgba(0,0,0,.9);font-size:34rpx;font-weight:600}.guide-desc{max-width:560rpx;margin-top:14rpx;color:rgba(0,0,0,.5);font-size:25rpx;line-height:1.65}.guide-button{margin-top:34rpx}.share-guide{display:flex;width:100%;align-items:center;justify-content:center;margin-top:30rpx;color:rgba(0,0,0,.42);font-size:21rpx}.share-dot{display:flex;width:34rpx;height:34rpx;align-items:center;justify-content:center;margin:0 8rpx;border-radius:50%;background:#f2f2f2}.guide-line{width:30rpx;height:1rpx;background:#d8d8d8}.summary-card{padding:30rpx}.summary-head{display:flex;align-items:center;justify-content:space-between}.summary-head>view{display:flex;flex-direction:column}.summary-head text:first-child{font-size:31rpx;font-weight:600}.summary-head text:last-child{margin-top:5rpx;color:#888;font-size:22rpx}.summary-head button{height:56rpx;margin:0;background:#f2f2f2;color:#666;font-size:22rpx;line-height:56rpx}.summary-grid{display:grid;grid-template-columns:repeat(4,1fr);margin-top:28rpx}.summary-grid>view{display:flex;flex-direction:column;align-items:center;border-right:1rpx solid rgba(0,0,0,.08)}.summary-grid>view:last-child{border:0}.summary-grid strong{font-size:38rpx;animation:number-in .42s .12s cubic-bezier(.22,1,.36,1) both}.summary-grid small{color:#888;font-size:21rpx;font-weight:400}.summary-grid text{margin-top:7rpx;color:#888;font-size:21rpx}.classroom-card{margin-bottom:24rpx;padding:28rpx}.room-enter{animation:room-card-in .38s cubic-bezier(.22,1,.36,1) both}.classroom-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}.classroom-identity{display:flex;min-width:0;flex:1;align-items:center}.classroom-state{display:flex;width:60rpx;height:60rpx;flex:0 0 auto;align-items:center;justify-content:center;border-radius:15rpx;background:#fff0f0;color:#cf3c3c;font-weight:600;transition:background-color .25s ease,color .25s ease,transform .25s cubic-bezier(.22,1,.36,1)}.classroom-state.online{background:#e9f8ef;color:#07a34f;animation:state-pop .38s cubic-bezier(.22,1,.36,1)}.classroom-copy{display:flex;min-width:0;flex:1;flex-direction:column;margin-left:18rpx}.classroom-copy text:first-child{overflow:hidden;font-size:30rpx;font-weight:600;text-overflow:ellipsis;white-space:nowrap}.classroom-copy text:last-child{display:-webkit-box;overflow:hidden;margin-top:5rpx;color:#888;font-size:22rpx;line-height:1.4;-webkit-box-orient:vertical;-webkit-line-clamp:2}.room-actions{display:flex;flex:0 0 auto;gap:10rpx}.room-actions .icon-button{position:relative;display:flex;width:58rpx;height:58rpx;min-width:58rpx;align-items:center;justify-content:center;margin:0;padding:0;border-radius:50%;background:#f4f5f6;color:#576b95;line-height:58rpx;transition:transform .18s cubic-bezier(.22,1,.36,1),opacity .18s ease}.room-actions .icon-button::after{border:0}.room-actions .leave{background:#fff1f0;color:#fa5151}.icon-pressed{opacity:.72!important;transform:scale(.82)!important}.settings-icon,.share-icon,.leave-icon{position:relative;width:30rpx;height:30rpx;color:inherit}.settings-icon i{position:absolute;left:3rpx;width:24rpx;height:3rpx;border-radius:2rpx;background:currentColor}.settings-icon i::after{position:absolute;width:7rpx;height:7rpx;border:3rpx solid currentColor;border-radius:50%;background:#f4f5f6;content:"";top:-5rpx}.settings-icon i:nth-child(1){top:5rpx}.settings-icon i:nth-child(1)::after{left:4rpx}.settings-icon i:nth-child(2){top:14rpx}.settings-icon i:nth-child(2)::after{right:3rpx}.settings-icon i:nth-child(3){top:23rpx}.settings-icon i:nth-child(3)::after{left:9rpx}.share-icon::before{position:absolute;left:4rpx;bottom:2rpx;width:20rpx;height:18rpx;border:3rpx solid currentColor;border-top:0;border-radius:3rpx;content:""}.share-icon::after{position:absolute;top:2rpx;left:13rpx;width:12rpx;height:12rpx;border-top:3rpx solid currentColor;border-right:3rpx solid currentColor;content:"";transform:rotate(-45deg)}.share-icon i{position:absolute;top:4rpx;left:14rpx;width:3rpx;height:17rpx;border-radius:2rpx;background:currentColor}.leave-icon::before{position:absolute;top:3rpx;left:2rpx;width:16rpx;height:24rpx;border:3rpx solid currentColor;border-right:0;border-radius:3rpx 0 0 3rpx;content:""}.leave-icon::after{position:absolute;top:8rpx;right:1rpx;width:11rpx;height:11rpx;border-top:3rpx solid currentColor;border-right:3rpx solid currentColor;content:"";transform:rotate(45deg)}.leave-icon i{position:absolute;top:14rpx;right:1rpx;width:19rpx;height:3rpx;border-radius:2rpx;background:currentColor}.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin-top:26rpx;padding-top:24rpx;border-top:1rpx solid rgba(0,0,0,.08)}.feature-grid button{display:flex;height:168rpx;flex-direction:column;align-items:center;justify-content:center;margin:0;padding:0;border-radius:16rpx;background:#f7f7f7;color:#191919;font-size:24rpx;line-height:1.3;transition:transform .18s cubic-bezier(.22,1,.36,1),background-color .18s ease}.feature-grid button::after{border:0}.feature-pressed{transform:scale(.95)!important;background:#f0f0f0!important}.feature-pressed .feature-icon{transform:scale(.9)}.feature-grid small{margin-top:6rpx;color:#999;font-size:19rpx}.feature-icon{display:flex;width:56rpx;height:56rpx;align-items:center;justify-content:center;margin-bottom:10rpx;border-radius:14rpx;font-size:24rpx;font-weight:600;transition:transform .18s cubic-bezier(.22,1,.36,1)}.call-icon{background:#e9f8ef;color:#07a34f}.homework-icon{background:#eef3ff;color:#576b95}.attendance-icon{background:#fff4e5;color:#c66a00}.loading-card{display:flex;align-items:center;justify-content:center;padding:40rpx;color:#888;font-size:24rpx}.loading-dot{width:16rpx;height:16rpx;margin-right:16rpx;border-radius:50%;background:#07c160;box-shadow:0 0 0 8rpx rgba(7,193,96,.12);animation:loading-pulse 1.05s ease-in-out infinite}
@keyframes home-welcome-in{from{opacity:0;transform:translateY(-10rpx)}to{opacity:1;transform:none}}@keyframes guide-mark-in{from{opacity:0;transform:scale(.62) rotate(-8deg)}to{opacity:1;transform:none}}@keyframes number-in{from{opacity:0;transform:translateY(8rpx) scale(.8)}to{opacity:1;transform:none}}@keyframes room-card-in{from{opacity:0;transform:translateY(22rpx) scale(.98)}to{opacity:1;transform:none}}@keyframes state-pop{0%{transform:scale(.75)}70%{transform:scale(1.08)}100%{transform:scale(1)}}@keyframes loading-pulse{0%,100%{opacity:.45;box-shadow:0 0 0 4rpx rgba(7,193,96,.08)}50%{opacity:1;box-shadow:0 0 0 12rpx rgba(7,193,96,.16)}}
@media(prefers-color-scheme:dark){.welcome-title,.guide-title,.summary-head text:first-child,.summary-grid strong,.classroom-copy text:first-child{color:rgba(255,255,255,.92)}.welcome-message,.guide-desc,.share-guide,.summary-head text:last-child,.summary-grid text,.classroom-copy text:last-child{color:rgba(255,255,255,.5)}.guide-scan-mark,.classroom-state.online{background:#173a29;color:#35d67c}.share-dot,.summary-head button,.feature-grid button{background:#2a2a2a;color:rgba(255,255,255,.9)}.room-actions .icon-button{background:#2a2d32;color:#aebff2}.room-actions .leave{background:#3a2022;color:#ff8d8d}.settings-icon i::after{background:#2a2d32}.guide-line{background:#444}.summary-grid>view,.feature-grid{border-color:rgba(255,255,255,.1)}.classroom-state{background:#3a2022;color:#ff8d8d}.call-icon{background:#173a29;color:#35d67c}.homework-icon{background:#252d40;color:#aebff2}.attendance-icon{background:#3b2c17;color:#ffc36b}}
.feature-grid button{width:100%;min-width:0}
.settings-icon>view{position:absolute;left:3rpx;width:24rpx;height:3rpx;border-radius:2rpx;background:currentColor}.settings-icon>view::after{position:absolute;top:-5rpx;width:7rpx;height:7rpx;border:3rpx solid currentColor;border-radius:50%;background:#f4f5f6;content:""}.settings-icon>view:nth-child(1){top:5rpx}.settings-icon>view:nth-child(1)::after{left:4rpx}.settings-icon>view:nth-child(2){top:14rpx}.settings-icon>view:nth-child(2)::after{right:3rpx}.settings-icon>view:nth-child(3){top:23rpx}.settings-icon>view:nth-child(3)::after{left:9rpx}.share-icon>view{position:absolute;top:4rpx;left:14rpx;width:3rpx;height:17rpx;border-radius:2rpx;background:currentColor}.leave-icon>view{position:absolute;top:14rpx;right:1rpx;width:19rpx;height:3rpx;border-radius:2rpx;background:currentColor}
@media(prefers-color-scheme:dark){.settings-icon>view::after{background:#2a2d32}}
.page>.surface.room-enter{animation:room-card-in .38s cubic-bezier(.22,1,.36,1) both}
@media(prefers-color-scheme:dark){.feature-pressed{background:#343434!important}}
@media(prefers-reduced-motion:reduce){.home-welcome,.guide-scan-mark,.summary-grid strong,.page>.surface.room-enter,.classroom-state.online,.loading-dot{animation:none}.classroom-state,.room-actions .icon-button,.feature-grid button,.feature-icon{transition:none}}

/* 教室状态卡片：用低饱和底色建立状态层级，同时保持微信式可读性。 */
.classroom-card{position:relative;border:1rpx solid transparent;transition:background-color .25s ease,border-color .25s ease,box-shadow .25s ease}
.classroom-card.status-online{border-color:#d9f1e2;background:#f7fcf9}.classroom-card.status-offline{border-color:#e4e6e8;background:#f5f6f7}.classroom-card.status-pending{border-color:#f4dfb6;background:#fffaf0}.classroom-card.status-identity-error{border-color:#f3d2d2;background:#fff6f6}.classroom-card.status-uninitialized{border-color:#d7e3f7;background:#f5f8ff}
.classroom-state.online{background:#dcf5e6;color:#078844}.classroom-state.offline{background:#e7e9eb;color:#7d8288}.classroom-state.pending{background:#fff0d2;color:#b96800}.classroom-state.identity-error{background:#fde2e2;color:#d63c3c}.classroom-state.uninitialized{background:#e3ecfb;color:#456b9f}
.classroom-title-line{display:flex;min-width:0;align-items:center;gap:12rpx}.classroom-title-line>text{min-width:0;overflow:hidden;font-size:30rpx;font-weight:600;text-overflow:ellipsis;white-space:nowrap}.room-status-label{flex:0 0 auto;padding:5rpx 12rpx;border-radius:18rpx;background:rgba(0,0,0,.055);color:#667085;font-size:19rpx;font-weight:500;line-height:1.3}.status-online .room-status-label{background:#dcf5e6;color:#078844}.status-pending .room-status-label{background:#fff0d2;color:#a65e00}.status-identity-error .room-status-label{background:#fde2e2;color:#c83232}.status-uninitialized .room-status-label{background:#e3ecfb;color:#456b9f}
.classroom-copy>.classroom-title-line+text{display:-webkit-box;overflow:hidden;margin-top:7rpx;color:#73777d;font-size:22rpx;line-height:1.45;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.feature-disabled{opacity:.52}.feature-grid.feature-disabled button{color:#777}.feature-grid button[disabled]{background:rgba(255,255,255,.64)}
@media(prefers-color-scheme:dark){.classroom-card.status-online{border-color:#205b3b;background:#152c20}.classroom-card.status-offline{border-color:#383b3f;background:#202225}.classroom-card.status-pending{border-color:#60491e;background:#302818}.classroom-card.status-identity-error{border-color:#623334;background:#321f21}.classroom-card.status-uninitialized{border-color:#30496d;background:#1c2738}.classroom-state.offline{background:#34373b;color:#b7bbc0}.classroom-state.pending,.status-pending .room-status-label{background:#503b16;color:#ffc46b}.classroom-state.identity-error,.status-identity-error .room-status-label{background:#542829;color:#ff9292}.classroom-state.uninitialized,.status-uninitialized .room-status-label{background:#273d5c;color:#a9c8f5}.status-online .room-status-label{background:#1f5436;color:#58dc8d}.room-status-label{background:#34373b;color:#b7bbc0}.classroom-copy>.classroom-title-line+text{color:rgba(255,255,255,.55)}.feature-grid button[disabled]{background:rgba(255,255,255,.055);color:rgba(255,255,255,.5)}}
