.home-welcome{padding:18rpx 8rpx 32rpx}.welcome-kicker{display:block;color:#07a34f;font-size:24rpx;font-weight:500}.welcome-title{display:block;margin-top:8rpx;color:rgba(0,0,0,.9);font-size:44rpx;font-weight:600;line-height:1.3}.welcome-message{display:block;margin-top:12rpx;color:rgba(0,0,0,.5);font-size:25rpx;line-height:1.55}.bind-guide{display:flex;flex-direction:column;align-items:center;padding:52rpx 38rpx 38rpx;text-align:center}.guide-scan-mark{display:flex;width:112rpx;height:112rpx;align-items:center;justify-content:center;border-radius:28rpx;background:#e9f8ef;color:#07c160;font-size:60rpx}.guide-title{margin-top:28rpx;color:rgba(0,0,0,.9);font-size:34rpx;font-weight:600}.guide-desc{max-width:560rpx;margin-top:14rpx;color:rgba(0,0,0,.5);font-size:25rpx;line-height:1.65}.guide-button{margin-top:34rpx}.share-guide{display:flex;width:100%;align-items:center;justify-content:center;margin-top:30rpx;color:rgba(0,0,0,.42);font-size:21rpx}.share-dot{display:flex;width:34rpx;height:34rpx;align-items:center;justify-content:center;margin:0 8rpx;border-radius:50%;background:#f2f2f2}.guide-line{width:30rpx;height:1rpx;background:#d8d8d8}.summary-card{padding:30rpx}.summary-head{display:flex;align-items:center;justify-content:space-between}.summary-head>view{display:flex;flex-direction:column}.summary-head text:first-child{font-size:31rpx;font-weight:600}.summary-head text:last-child{margin-top:5rpx;color:#888;font-size:22rpx}.summary-head button{height:56rpx;margin:0;background:#f2f2f2;color:#666;font-size:22rpx;line-height:56rpx}.summary-grid{display:grid;grid-template-columns:repeat(4,1fr);margin-top:28rpx}.summary-grid>view{display:flex;flex-direction:column;align-items:center;border-right:1rpx solid rgba(0,0,0,.08)}.summary-grid>view:last-child{border:0}.summary-grid strong{font-size:38rpx}.summary-grid small{color:#888;font-size:21rpx;font-weight:400}.summary-grid text{margin-top:7rpx;color:#888;font-size:21rpx}.classroom-card{margin-bottom:24rpx;padding:28rpx}.