<view class="page homework-page">
  <view class="page-toolbar">
    <view class="page-heading"><text class="page-kicker">{{className || roomName || statusMessage}}</text><text class="page-title">作业</text></view>
    <button class="header-action compose-button" size="mini" data-type="{{contentType}}" bindtap="openComposer" wx:if="{{canCompose}}">{{contentType === 'notice' ? '发布通知' : '布置作业'}}</button>
  </view>

  <view class="content-switch" role="tablist" aria-label="内容类型"><view role="tab" aria-selected="{{contentType === 'homework'}}" class="{{contentType === 'homework' ? 'active' : ''}}" data-type="homework" bindtap="selectContentType" hover-class="segment-pressed">作业</view><view role="tab" aria-selected="{{contentType === 'notice'}}" class="{{contentType === 'notice' ? 'active' : ''}}" data-type="notice" bindtap="selectContentType" hover-class="segment-pressed">通知</view></view>

  <view class="stage-switch surface" role="tablist" aria-label="作业状态">
    <view role="tab" aria-selected="{{homeworkStage === 'pending'}}" class="stage-option {{homeworkStage === 'pending' ? 'active' : ''}}" data-stage="pending" bindtap="selectStage" hover-class="segment-pressed"><view><text>{{contentType === 'notice' ? '生效中通知' : '待提交作业'}}</text><text>{{contentType === 'notice' ? '未到结束时间' : '未到截止时间'}}</text></view><text class="stage-count">{{contentType === 'notice' ? activeNoticeCount : pendingCount}}</text></view>
    <view role="tab" aria-selected="{{homeworkStage === 'closed'}}" class="stage-option {{homeworkStage === 'closed' ? 'active' : ''}}" data-stage="closed" bindtap="selectStage" hover-class="segment-pressed"><view><text>{{contentType === 'notice' ? '历史通知' : '提交统计'}}</text><text>{{contentType === 'notice' ? '已到结束时间' : '已到截止时间'}}</text></view><text class="stage-count">{{contentType === 'notice' ? endedNoticeCount : closedCount}}</text></view>
  </view>

  <view class="subject-filter" wx:if="{{subjects.length}}">
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}">
      <view class="filter-inner" role="radiogroup" aria-label="按学科筛选"><view role="radio" aria-checked="{{selectedSubject === ''}}" class="filter-chip {{selectedSubject === '' ? 'active' : ''}}" data-subject="" bindtap="selectSubject" hover-class="chip-pressed">全部</view><view role="radio" aria-checked="{{selectedSubject === item}}" class="filter-chip {{selectedSubject === item ? 'active' : ''}}" wx:for="{{subjects}}" wx:key="*this" data-subject="{{item}}" bindtap="selectSubject" hover-class="chip-pressed">{{item}}</view></view>
    </scroll-view>
  </view>

  <view class="assignment-groups" wx:if="{{visibleAssignments.length}}">
    <view class="date-section" wx:for="{{visibleAssignments}}" wx:key="date">
      <view class="section-heading date-heading"><view><text class="section-title">{{item.dateLabel}}</text><text class="section-note">{{item.total}} {{contentType === 'notice' ? '条通知' : '项作业'}}</text></view></view>
      <view class="deadline-group surface {{contentType === 'notice' ? 'notice-group' : ''}}">
        <view class="assignment-cell" wx:for="{{item.items}}" wx:key="id" wx:for-item="assignment">
          <view class="assignment-top"><view class="assignment-tags"><text class="subject-pill">{{assignment.subject}}</text><text class="student-source" wx:if="{{assignment.isStudentCreated}}">学生补录</text></view><text class="assignment-deadline">{{assignment.deadlineText}}</text></view>
          <text class="assignment-title">{{assignment.title}}</text>
          <block wx:if="{{!assignment.isNotice}}"><view class="progress-track"><view class="progress-value" style="width:{{assignment.summary.rate}}%"></view></view><view class="submission-stats"><text><text class="stat-number">{{assignment.summary.submitted}}</text> 已提交</text><text class="pending"><text class="stat-number">{{assignment.summary.pending}}</text> 待提交</text><text class="late" wx:if="{{assignment.summary.late}}"><text class="stat-number">{{assignment.summary.late}}</text> 迟交</text><text class="rate">{{assignment.summary.rate}}%</text></view></block>
          <block wx:else><view class="notice-state"><text>{{homeworkStage === 'pending' ? '生效中' : '已结束'}}</text><text>{{assignment.deadlineText}}</text></view></block>
          <view class="assignment-actions"><button wx:if="{{!assignment.isNotice}}" class="detail-button" data-id="{{assignment.id}}" bindtap="openAssignmentDetail">查看提交详情</button><button wx:if="{{assignment.canManage}}" data-id="{{assignment.id}}" catchtap="editAssignment">编辑</button><button wx:if="{{assignment.canManage}}" class="delete" loading="{{deletingAssignmentId === assignment.id}}" disabled="{{!!deletingAssignmentId}}" data-id="{{assignment.id}}" catchtap="deleteAssignment">删除</button></view>
        </view>
      </view>
    </view>
  </view>

  <view class="surface empty assignment-empty" wx:else>
    <view class="empty-mark">{{homeworkStage === 'pending' ? '✓' : '◷'}}</view><text class="empty-title">{{selectedSubject ? (contentType === 'notice' ? '该学科暂无通知' : '该学科暂无作业') : (contentType === 'notice' ? (homeworkStage === 'pending' ? '当前没有生效中的通知' : '当前没有历史通知') : (homeworkStage === 'pending' ? '当前没有待提交作业' : '当前没有已截止作业'))}}</text><text class="empty-desc">{{contentType === 'notice' ? (homeworkStage === 'pending' ? '新通知会在结束时间前显示在这里。' : '通知结束后会自动进入历史记录。') : (homeworkStage === 'pending' ? '新布置且未到截止时间的作业会显示在这里。' : '作业到达截止时间后会自动进入提交统计。')}}</text>
  </view>

  <page-container show="{{composerOpen}}" position="bottom" round overlay close-on-slide-down bind:clickoverlay="closeComposer" bind:afterleave="closeComposer">
    <view class="bottom-sheet composer-sheet">
      <view class="sheet-handle"></view>
      <view class="sheet-title"><view><text>{{editingAssignmentId ? (publishType === 'notice' ? '编辑通知' : '编辑作业') : (publishType === 'notice' ? '发布通知' : '布置作业')}}</text><text class="sheet-subtitle">{{editingAssignmentId ? '修改后将同步到教室端和其他教师设备' : (publishType === 'notice' ? '结束后自动进入历史通知' : '截止后自动进入提交统计')}}</text></view><button class="sheet-close" aria-label="关闭编辑" bindtap="closeComposer" disabled="{{composerSubmitting}}">×</button></view>
      <view class="publish-switch" role="tablist" aria-label="发布类型" wx:if="{{!editingAssignmentId}}"><view role="tab" aria-selected="{{publishType === 'homework'}}" class="{{publishType === 'homework' ? 'active' : ''}}" data-type="homework" bindtap="selectPublishType" hover-class="segment-pressed">作业</view><view role="tab" aria-selected="{{publishType === 'notice'}}" class="{{publishType === 'notice' ? 'active' : ''}}" data-type="notice" bindtap="selectPublishType" hover-class="segment-pressed">通知</view></view>
      <text class="label">授课学科</text>
      <picker aria-label="选择授课学科" mode="selector" range="{{allowedSubjects}}" value="{{draftSubjectIndex}}" disabled="{{editingAssignmentId && !isHomeroom}}" bindchange="setDraftSubject"><view class="picker-field {{editingAssignmentId && !isHomeroom ? 'disabled' : ''}}"><text>{{allowedSubjects[draftSubjectIndex] || '请选择学科'}}</text><text class="picker-arrow" wx:if="{{!editingAssignmentId || isHomeroom}}">›</text></view></picker>
      <text class="label">{{publishType === 'notice' ? '通知内容' : '作业内容'}}</text>
      <textarea class="assignment-input" aria-label="{{publishType === 'notice' ? '通知内容' : '作业内容'}}" maxlength="200" auto-height placeholder="{{publishType === 'notice' ? '例如：明天下午第二节课调至实验室' : '例如：完成练习册第 12—14 页'}}" value="{{draftTitle}}" bindinput="setDraftTitle"></textarea>
      <text class="label">{{publishType === 'notice' ? '通知结束时间' : '提交截止时间'}}</text>
      <view class="deadline-row"><picker aria-label="选择日期" mode="date" value="{{draftDate}}" start="{{today}}" bindchange="setDraftDate"><view class="picker-field">{{draftDate}}</view></picker><picker aria-label="选择时间" mode="time" value="{{draftTime}}" bindchange="setDraftTime"><view class="picker-field">{{draftTime}}</view></picker></view>
      <button class="primary submit-assignment" bindtap="submitAssignment" loading="{{composerSubmitting}}" disabled="{{composerSubmitting || !draftTitle || !allowedSubjects.length}}">{{composerSubmitting ? '正在同步' : (editingAssignmentId ? '保存修改' : (publishType === 'notice' ? '确认发布' : '确认布置'))}}</button>
    </view>
  </page-container>

  <page-container show="{{detailOpen}}" position="bottom" round overlay close-on-slide-down="{{!detailSavingStudentId}}" bind:clickoverlay="closeAssignmentDetail">
    <view class="bottom-sheet detail-sheet" role="dialog" aria-label="作业提交详情">
      <view class="sheet-handle"></view>
      <view class="sheet-title"><view><text>{{detailTitle}}</text><text class="sheet-subtitle">{{detailSubject}} · {{detailDeadline}}</text></view><button class="sheet-close" aria-label="关闭提交详情" bindtap="closeAssignmentDetail" disabled="{{!!detailSavingStudentId}}">×</button></view>
      <view class="detail-summary" wx:if="{{detailSummary}}"><view><strong>{{detailSummary.submitted}}</strong><text>已提交</text></view><view><strong>{{detailSummary.pending}}</strong><text>未提交</text></view><view><strong>{{detailSummary.late}}</strong><text>迟交</text></view><view><strong>{{detailSummary.rate}}%</strong><text>完成率</text></view></view>
      <scroll-view class="detail-filters" scroll-x show-scrollbar="{{false}}" role="tablist" aria-label="提交状态筛选"><view><button role="tab" aria-selected="{{detailFilter === 'all'}}" class="{{detailFilter === 'all' ? 'active' : ''}}" data-status="all" bindtap="setDetailFilter">全部</button><button role="tab" aria-selected="{{detailFilter === '未提交'}}" class="{{detailFilter === '未提交' ? 'active' : ''}}" data-status="未提交" bindtap="setDetailFilter">未提交</button><button role="tab" aria-selected="{{detailFilter === '已提交'}}" class="{{detailFilter === '已提交' ? 'active' : ''}}" data-status="已提交" bindtap="setDetailFilter">已提交</button><button role="tab" aria-selected="{{detailFilter === '迟交'}}" class="{{detailFilter === '迟交' ? 'active' : ''}}" data-status="迟交" bindtap="setDetailFilter">迟交</button><button role="tab" aria-selected="{{detailFilter === '免交'}}" class="{{detailFilter === '免交' ? 'active' : ''}}" data-status="免交" bindtap="setDetailFilter">免交</button></view></scroll-view>
      <scroll-view class="detail-student-list" scroll-y><button class="detail-student" wx:for="{{detailStudents}}" wx:key="id" data-student-id="{{item.id}}" bindtap="chooseStudentStatus" loading="{{detailSavingStudentId === item.id}}" disabled="{{!!detailSavingStudentId}}" aria-label="{{item.name}}，当前{{item.status}}，点击修改"><view class="detail-avatar">{{item.initial}}</view><text>{{item.name}}</text><label class="status-{{item.statusClass}}">{{item.status}}</label><text class="detail-chevron">›</text></button><view class="detail-empty" wx:if="{{!detailStudents.length}}">当前筛选下没有学生</view></scroll-view>
    </view>
  </page-container>
</view>
