.compose-button { background: #07c160; color: #fff; }
.content-switch,.publish-switch { display:grid; grid-template-columns:repeat(2,1fr); gap:6rpx; padding:6rpx; border-radius:16rpx; background:#e9ecf0; }.content-switch { margin-bottom:18rpx; }.content-switch view,.publish-switch view { padding:14rpx 20rpx; border-radius:12rpx; color:rgba(0,0,0,.5); text-align:center; font-size:25rpx; font-weight:500; }.content-switch view.active,.publish-switch view.active { color:rgba(0,0,0,.9); background:#fff; box-shadow:0 2rpx 8rpx rgba(0,0,0,.08); }.publish-switch { margin:4rpx 0 22rpx; }
.stage-switch { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12rpx; padding: 12rpx; }
.stage-option { display: flex; align-items: center; min-width: 0; padding: 22rpx 20rpx; border-radius: 16rpx; color: rgba(0,0,0,.55); background: #f7f7f7; }
.stage-option > view { flex: 1; min-width: 0; }.stage-option text { display: block; }
.stage-option > view > text:first-child { color: rgba(0,0,0,.8); font-size: 27rpx; font-weight: 600; }
.stage-option > view > text:last-child { margin-top: 5rpx; color: rgba(0,0,0,.4); font-size: 20rpx; }
.stage-count { margin-left: 12rpx; font-size: 34rpx; font-weight: 650; }
.stage-option.active { background: #e9f8ef; color: #07a852; }.stage-option.active > view > text:first-child { color: #078d47; }
.subject-filter { width: calc(100% + 64rpx); margin: 28rpx -32rpx 0; white-space: nowrap; }
.filter-inner { padding: 0 32rpx; }
.filter-chip { display: inline-flex; align-items: center; height: 64rpx; margin-right: 14rpx; padding: 0 26rpx; border-radius: 12rpx; background: #fff; color: rgba(0, 0, 0, .6); font-size: 25rpx; }
.filter-chip.active { background: #07c160; color: #fff; font-weight: 500; }
.assignment-groups { margin-top: 8rpx; }
.date-heading { margin-top: 36rpx; }
.deadline-group { margin-bottom: 20rpx; }.assignment-cell { padding: 24rpx; }
.assignment-cell + .assignment-cell { border-top: 1rpx solid rgba(0, 0, 0, .08); }
.assignment-top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.assignment-tags { display:flex;min-width:0;align-items:center;gap:10rpx; }
.subject-pill { flex: 0 0 auto; padding: 6rpx 14rpx; border-radius: 9rpx; color: #078d47; background: #e9f8ef; font-size: 21rpx; font-weight: 600; }
.student-source { flex:0 0 auto;padding:6rpx 12rpx;border-radius:9rpx;color:#8a5a00;background:#fff3cf;font-size:20rpx;font-weight:600; }
.assignment-title { display: block; margin-top: 16rpx; color: rgba(0, 0, 0, .9); font-size: 29rpx; font-weight: 600; line-height: 1.45; }
.assignment-deadline { color: rgba(0, 0, 0, .45); font-size: 21rpx; }
.progress-track { height: 8rpx; margin-top: 22rpx; overflow: hidden; border-radius: 8rpx; background: #edf0f2; }.progress-value { height: 100%; border-radius: inherit; background: #07c160; }
.submission-stats { display: flex; align-items: center; gap: 20rpx; margin-top: 15rpx; color: rgba(0,0,0,.45); font-size: 21rpx; }.submission-stats .stat-number { color: #078d47; font-size: 24rpx; font-weight: 600; }.submission-stats .pending .stat-number { color: #d05f00; }.submission-stats .late .stat-number { color: #b53a42; }.submission-stats .rate { margin-left: auto; color: rgba(0,0,0,.65); font-weight: 600; }
.notice-state { display:flex; align-items:center; justify-content:space-between; margin-top:20rpx; padding-top:16rpx; border-top:1rpx solid rgba(0,0,0,.07); color:rgba(0,0,0,.4); font-size:21rpx; }.notice-state text:first-child { padding:5rpx 12rpx; border-radius:8rpx; color:#9a6500; background:#fff3d6; font-weight:600; }
.assignment-actions{display:flex;justify-content:flex-end;gap:12rpx;margin-top:16rpx;padding-top:14rpx;border-top:1rpx solid rgba(0,0,0,.07)}.assignment-actions button{width:auto;height:64rpx;margin:0;padding:0 24rpx;border-radius:12rpx;background:#f2f2f2;color:#576b95;font-size:24rpx;line-height:64rpx}.assignment-actions button::after{border:0}.assignment-actions .detail-button{margin-right:auto;background:#e9f8ef;color:#078d47}.assignment-actions .delete{background:#fff1f0;color:#fa5151}.picker-field.disabled{background:#f5f5f5;color:rgba(0,0,0,.5)}
.assignment-empty { margin-top: 32rpx; }
.composer-sheet { padding-bottom: calc(36rpx + env(safe-area-inset-bottom)); }
.assignment-input { min-height: 136rpx; padding: 22rpx 24rpx; line-height: 1.55; }
.deadline-row { display: grid; grid-template-columns: 1.35fr .8fr; gap: 16rpx; }
.picker-arrow { color: rgba(0, 0, 0, .3); font-size: 38rpx; }
.submit-assignment { margin-top: 36rpx; }
.sheet-close{display:grid;width:72rpx;height:72rpx;margin:0;padding:0;place-items:center;border:0;border-radius:50%;color:rgba(0,0,0,.5);background:#f3f3f3;font-size:40rpx;line-height:1}.sheet-close::after{border:0}
.detail-sheet{padding-bottom:calc(24rpx + env(safe-area-inset-bottom))}.detail-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx;margin:8rpx 0 24rpx}.detail-summary view{display:flex;flex-direction:column;align-items:center;padding:18rpx 8rpx;border-radius:14rpx;background:#f7f8fa}.detail-summary strong{font-size:31rpx}.detail-summary text{margin-top:5rpx;color:rgba(0,0,0,.5);font-size:23rpx}.detail-filters{width:100%;white-space:nowrap}.detail-filters>view{display:flex;gap:12rpx;padding-bottom:18rpx}.detail-filters button{width:auto;height:64rpx;margin:0;padding:0 24rpx;border:0;border-radius:32rpx;background:#f3f4f6;color:rgba(0,0,0,.6);font-size:24rpx;line-height:64rpx}.detail-filters button::after{border:0}.detail-filters button.active{color:#fff;background:#07c160}.detail-student-list{height:min(620rpx,48vh)}.detail-student{display:flex;width:100%;min-height:92rpx;align-items:center;margin:0;padding:12rpx 4rpx;border:0;border-bottom:1rpx solid rgba(0,0,0,.07);border-radius:0;background:transparent;color:rgba(0,0,0,.88);text-align:left}.detail-student::after{border:0}.detail-avatar{display:grid;width:64rpx;height:64rpx;flex:0 0 64rpx;margin-right:18rpx;place-items:center;border-radius:50%;color:#078d47;background:#e9f8ef;font-size:25rpx;font-weight:600}.detail-student>text:nth-of-type(1){flex:1;font-size:27rpx;font-weight:600}.detail-student label{padding:7rpx 13rpx;border-radius:10rpx;font-size:22rpx}.detail-student .status-submitted{color:#078d47;background:#e9f8ef}.detail-student .status-pending{color:#b45b00;background:#fff3df}.detail-student .status-late{color:#b53a42;background:#fff0f0}.detail-student .status-exempt{color:#576b95;background:#eef2ff}.detail-chevron{margin-left:10rpx;color:rgba(0,0,0,.3);font-size:34rpx}.detail-empty{padding:80rpx 0;color:rgba(0,0,0,.45);font-size:25rpx;text-align:center}
@media (max-width: 340px) { .deadline-row { grid-template-columns: 1fr; } }
@media (prefers-color-scheme: dark) {
  .content-switch, .publish-switch { background:#292929; }.content-switch view.active, .publish-switch view.active { background:#3a3a3a; color:rgba(255,255,255,.92); }.content-switch view, .publish-switch view { color:rgba(255,255,255,.58); }
  .stage-option { background:#292929; color:rgba(255,255,255,.6); }.stage-option > view > text:first-child { color:rgba(255,255,255,.86); }.stage-option > view > text:last-child { color:rgba(255,255,255,.5); }.stage-option.active { background:#173a29; color:#35d67c; }.stage-option.active > view > text:first-child { color:#35d67c; }
  .filter-chip { background:#242424; color:rgba(255,255,255,.65); }.filter-chip.active { background:#07c160; color:#fff; }
  .subject-pill { background:#173a29; color:#35d67c; }.student-source{color:#ffc86f;background:#44351b}.assignment-title { color:rgba(255,255,255,.92); }.assignment-deadline, .submission-stats { color:rgba(255,255,255,.55); }.progress-track { background:#343434; }.notice-state,.assignment-actions { border-color:rgba(255,255,255,.1); }.notice-state { color:rgba(255,255,255,.55); }.notice-state text:first-child { background:#4a3515; color:#ffc36b; }.assignment-actions button{background:#2a2a2a;color:#aebff2}.assignment-actions .detail-button{background:#173a29;color:#35d67c}.assignment-actions .delete{background:#3a2022;color:#ff8d8d}.picker-field.disabled{background:#242424;color:rgba(255,255,255,.5)}.sheet-close,.detail-summary view,.detail-filters button{background:#292929;color:rgba(255,255,255,.72)}.detail-summary text,.detail-empty{color:rgba(255,255,255,.55)}.detail-filters button.active{background:#07c160;color:#fff}.detail-student{color:rgba(255,255,255,.9);border-color:rgba(255,255,255,.1)}.detail-chevron{color:rgba(255,255,255,.35)}
}
.homework-page { padding-bottom:48rpx; }

/* 页面内切换与数据变化使用短促、可打断的微信式反馈。 */
.content-switch view,.publish-switch view{transition:transform .16s cubic-bezier(.22,1,.36,1),background-color .22s ease,color .22s ease,box-shadow .22s ease}
.content-switch view.active,.publish-switch view.active{animation:segment-select .25s cubic-bezier(.22,1,.36,1)}
.segment-pressed,.chip-pressed{opacity:.76;transform:scale(.96)}
.stage-option.active{box-shadow:inset 0 0 0 1rpx rgba(7,193,96,.12)}
.stage-option.active .stage-count{animation:count-pop .28s cubic-bezier(.22,1,.36,1)}
.filter-chip{transition:transform .16s cubic-bezier(.22,1,.36,1),background-color .2s ease,color .2s ease}
.date-section{animation:assignment-section-in .32s cubic-bezier(.22,1,.36,1) both}
.progress-value{transform-origin:left center;animation:progress-grow .55s .08s cubic-bezier(.22,1,.36,1) both;transition:width .4s cubic-bezier(.22,1,.36,1)}
.assignment-actions button{transition:transform .16s cubic-bezier(.22,1,.36,1),opacity .16s ease}
@keyframes segment-select{from{transform:scale(.94)}to{transform:scale(1)}}
@keyframes count-pop{0%{opacity:.4;transform:scale(.72)}70%{transform:scale(1.12)}100%{opacity:1;transform:scale(1)}}
@keyframes assignment-section-in{from{opacity:0;transform:translateY(16rpx)}to{opacity:1;transform:none}}
@keyframes progress-grow{from{transform:scaleX(0)}to{transform:scaleX(1)}}
@media(prefers-reduced-motion:reduce){.content-switch view.active,.publish-switch view.active,.stage-option.active .stage-count,.date-section,.progress-value{animation:none}.content-switch view,.publish-switch view,.filter-chip,.progress-value,.assignment-actions button{transition:none}}
