.compose-button { background: #07c160; color: #fff; }
.overview { display: grid; grid-template-columns: repeat(3, 1fr); padding: 28rpx 0; }
.overview-item { text-align: center; }
.overview-item + .overview-item { border-left: 1rpx solid rgba(0, 0, 0, .08); }
.overview-item text { display: block; color: rgba(0, 0, 0, .9); font-size: 38rpx; font-weight: 600; line-height: 1.1; }
.overview-item text:last-child { margin-top: 12rpx; color: rgba(0, 0, 0, .45); font-size: 22rpx; font-weight: 400; }
.subject-filter { width: calc(100% + 64rpx); margin: 28rpx -32rpx 0; white-space: nowrap; }
.filter-inner { padding: 0 32rpx; }
.filter-chip { display: inline-flex; align-items: center; height: 64rpx; margin-right: 14rpx; padding: 0 26rpx; border-radius: 12rpx; background: #fff; color: rgba(0, 0, 0, .6); font-size: 25rpx; }
.filter-chip.active { background: #07c160; color: #fff; font-weight: 500; }
.assignment-groups { margin-top: 8rpx; }
.date-heading { margin-top: 36rpx; }
.subject-group { margin-bottom: 20rpx; }
.subject-header { display: flex; align-items: center; min-height: 82rpx; padding: 18rpx 24rpx; background: #fafafa; }
.subject-dot { width: 14rpx; height: 14rpx; margin-right: 14rpx; border-radius: 50%; background: #07c160; }
.subject-header text { flex: 1; color: rgba(0, 0, 0, .9); font-size: 27rpx; font-weight: 600; }
.subject-header text:last-child { flex: 0 0 auto; color: rgba(0, 0, 0, .4); font-size: 22rpx; font-weight: 400; }
.assignment-cell { display: flex; align-items: center; min-height: 112rpx; padding: 20rpx 24rpx; }
.assignment-cell + .assignment-cell { border-top: 1rpx solid rgba(0, 0, 0, .08); }
.assignment-main { flex: 1; min-width: 0; }
.assignment-title { display: block; color: rgba(0, 0, 0, .9); font-size: 28rpx; font-weight: 500; line-height: 1.45; }
.assignment-deadline { display: block; margin-top: 7rpx; color: rgba(0, 0, 0, .45); font-size: 22rpx; }
.submission { flex: 0 0 auto; margin-left: 22rpx; text-align: right; }
.submission text { display: block; color: #07c160; font-size: 27rpx; font-weight: 600; }
.submission text:last-child { margin-top: 4rpx; color: rgba(0, 0, 0, .4); font-size: 20rpx; font-weight: 400; }
.assignment-empty { margin-top: 32rpx; }
.composer-sheet { padding-bottom: calc(36rpx + env(safe-area-inset-bottom)); }
.assignment-input { min-height: 136rpx; padding: 22rpx 24rpx; line-height: 1.55; }
.deadline-row { display: grid; grid-template-columns: 1.35fr .8fr; gap: 16rpx; }
.picker-arrow { color: rgba(0, 0, 0, .3); font-size: 38rpx; }
.submit-assignment { margin-top: 36rpx; }
@media (max-width: 340px) { .deadline-row { grid-template-columns: 1fr; } }
