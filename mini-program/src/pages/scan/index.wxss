.scan-page { padding-bottom: 56rpx; }
.scan-hero { display:flex; flex-direction:column; align-items:center; padding:50rpx 44rpx 40rpx; text-align:center; }
.scan-visual { position:relative; display:flex; overflow:hidden; align-items:center; justify-content:center; width:188rpx; height:188rpx; margin-bottom:30rpx; border-radius:36rpx; background:#f0faf4; transition:transform .18s cubic-bezier(.22,1,.36,1),background .18s ease; }
.scan-visual::after{position:absolute;right:30rpx;left:30rpx;height:3rpx;border-radius:3rpx;background:linear-gradient(90deg,transparent,#07c160,transparent);content:"";opacity:.72;animation:scan-line 2.2s ease-in-out infinite}
.scan-visual_active { background:#e5f7ec; transform:scale(.96); }
.scan-corner { position:absolute; width:43rpx; height:43rpx; border-color:#07c160; }
.top-left { top:25rpx; left:25rpx; border-top:7rpx solid #07c160; border-left:7rpx solid #07c160; border-radius:8rpx 0 0; }
.top-right { top:25rpx; right:25rpx; border-top:7rpx solid #07c160; border-right:7rpx solid #07c160; border-radius:0 8rpx 0 0; }
.bottom-left { bottom:25rpx; left:25rpx; border-bottom:7rpx solid #07c160; border-left:7rpx solid #07c160; border-radius:0 0 0 8rpx; }
.bottom-right { right:25rpx; bottom:25rpx; border-right:7rpx solid #07c160; border-bottom:7rpx solid #07c160; border-radius:0 0 8rpx; }
.scan-glyph { display:grid; grid-template-columns:repeat(3,14rpx); gap:9rpx; }
.scan-glyph view { width:14rpx; height:14rpx; border-radius:3rpx; background:#07c160; }
.scan-glyph view:nth-child(2),.scan-glyph view:nth-child(4) { opacity:.45; }
.scan-title { color:rgba(0,0,0,.9); font-size:34rpx; font-weight:600; }
.scan-desc { max-width:530rpx; margin-top:14rpx; color:rgba(0,0,0,.5); font-size:25rpx; line-height:1.6; }
.scan-button { width:100%; margin-top:34rpx; }
.scan-options { overflow:hidden; }
.scan-option { display:flex; min-height:128rpx; align-items:center; padding:22rpx 28rpx; transition:transform .16s cubic-bezier(.22,1,.36,1),background-color .18s ease; }
.scan-option + .scan-option { border-top:1rpx solid rgba(0,0,0,.08); }
.scan-option_active { background:rgba(0,0,0,.04); transform:scale(.99); }
.option-icon { display:flex; width:72rpx; height:72rpx; flex:0 0 72rpx; align-items:center; justify-content:center; margin-right:22rpx; border-radius:18rpx; font-size:27rpx; font-weight:600; }
.teacher-icon { color:#576b95; background:#eef1f8; }.room-icon { color:#078844; background:#e9f8ef; }
.option-copy { display:flex; min-width:0; flex:1; flex-direction:column; }
.option-copy text:first-child { color:rgba(0,0,0,.9); font-size:29rpx; font-weight:500; }
.option-copy text:last-child { margin-top:6rpx; color:rgba(0,0,0,.45); font-size:23rpx; line-height:1.45; }
.option-arrow { margin-left:16rpx; color:rgba(0,0,0,.28); font-size:42rpx; font-family:Arial,sans-serif; }
.current-summary { display:flex; align-items:center; margin-top:24rpx; padding:22rpx 26rpx; border-radius:16rpx; background:#e9f8ef; color:#167c42; font-size:24rpx; animation:summary-in .32s cubic-bezier(.22,1,.36,1) both; }
.summary-dot { width:14rpx; height:14rpx; margin-right:14rpx; border-radius:50%; background:#07c160; }
.summary-count { margin-left:auto; color:#4b8f67; }
.share-room-button { display:flex; width:100%; height:88rpx; align-items:center; justify-content:center; margin:20rpx 0 0; border-radius:16rpx; background:#07c160; color:#fff; font-size:29rpx; font-weight:500; line-height:88rpx; }.share-room-button::after { border:0; }
.share-permission-tip { padding:24rpx 22rpx 0; color:rgba(0,0,0,.45); font-size:22rpx; line-height:1.5; text-align:center; }
.privacy-tip { padding:28rpx 24rpx 0; color:rgba(0,0,0,.4); font-size:22rpx; line-height:1.6; text-align:center; }
@keyframes scan-line{0%,100%{opacity:0;transform:translateY(-56rpx)}18%,82%{opacity:.72}50%{transform:translateY(56rpx)}}
@keyframes summary-in{from{opacity:0;transform:translateY(10rpx)}to{opacity:1;transform:none}}
@media (prefers-color-scheme: dark) {
  .scan-visual { background:#173a29; }.scan-visual_active { background:#1c4832; }
  .scan-title,.option-copy text:first-child { color:rgba(255,255,255,.92); }
  .scan-desc,.option-copy text:last-child,.privacy-tip { color:rgba(255,255,255,.5); }
  .scan-option + .scan-option { border-color:rgba(255,255,255,.1); }.scan-option_active { background:rgba(255,255,255,.06); }
  .teacher-icon { color:#a8b8d8; background:#283040; }.room-icon { color:#45d487; background:#173a29; }.option-arrow { color:rgba(255,255,255,.3); }
  .current-summary { color:#63d698; background:#173a29; }.summary-count { color:#58a87b; }
  .share-permission-tip { color:rgba(255,255,255,.48); }
}
@media(prefers-reduced-motion:reduce){.scan-visual::after,.current-summary{animation:none}.scan-visual,.scan-option{transition:none}}
