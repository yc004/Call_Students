<view class="page settings-page">
  <view class="settings-head"><view><text class="page-title">{{className || '教室设置'}}</text><text class="page-kicker">{{isHomeroom?'班主任管理中心':'教室与身份设置'}}</text></view><view class="connection-state {{status}}"><view></view><text>{{statusText}}</text></view></view>
  <view class="surface room-settings-card"><view class="room-settings-main"><view class="room-settings-mark">{{isHomeroom?'班':'教'}}</view><view><text>{{teacherRole}}</text><small>教室连接码 {{connectionCode}}</small></view></view><button class="room-exit-button" bindtap="leaveRoom" hover-class="room-exit-pressed">退出教室</button></view>
  <view class="segmented" wx:if="{{isHomeroom}}"><button class="{{tab==='students'?'active':''}}" data-tab="students" bindtap="switchTab" hover-class="segment-pressed">学生名单</button><button class="{{tab==='teachers'?'active':''}}" data-tab="teachers" bindtap="switchTab" hover-class="segment-pressed">教师成员</button><button class="{{tab==='faces'?'active':''}}" data-tab="faces" bindtap="switchTab" hover-class="segment-pressed">人脸管理<text wx:if="{{pendingFaces.length}}">{{pendingFaces.length}}</text></button></view>

  <block wx:if="{{isHomeroom && tab==='students'}}">
    <view class="surface form-card"><text class="form-label">班级名称</text><input class="field" maxlength="40" value="{{className}}" bindinput="onClassNameInput" placeholder="请输入班级名称"/><view class="list-heading"><view><text>学生名单</text><small>共 {{students.length}} 人</small></view><view class="student-add-actions"><button bindtap="openBatch">批量添加</button><button bindtap="addStudent">＋ 单个添加</button></view></view><view class="student-row" wx:for="{{students}}" wx:key="id"><view class="student-index">{{index+1}}</view><input maxlength="20" value="{{item.name}}" data-index="{{index}}" bindinput="onStudentInput" placeholder="学生姓名"/><button class="remove" data-index="{{index}}" bindtap="removeStudent">移除</button></view><button class="primary save-button" loading="{{saving}}" bindtap="saveClassroom">保存班级资料</button></view>
  </block>

  <block wx:elif="{{isHomeroom && tab==='teachers'}}">
    <view class="surface teacher-invite-card">
      <view class="invite-icon"><view></view><view></view></view>
      <view class="invite-copy"><text>邀请教师加入</text><small>通过微信发送教室邀请，对方设置授课科目并申请加入后，由你在这里审核。</small></view>
      <button wx:if="{{!isCloudRoom}}" open-type="share" data-action="invite-teacher" hover-class="invite-button-pressed">微信邀请</button>
      <button wx:else bindtap="showCloudInviteHelp" hover-class="invite-button-pressed">添加云端教师</button>
    </view>
    <view class="section-heading"><view><text class="section-title">待审核</text><text class="section-note">新教师加入教室前需要班主任批准</text></view><text class="count-badge">{{pendingTeachers.length}}</text></view>
    <view class="surface member-list"><view class="empty-inline" wx:if="{{!pendingTeachers.length}}"><text>暂无待审核教师</text><small>邀请发出后，新的加入申请会显示在这里</small></view><view class="member-row" wx:for="{{pendingTeachers}}" wx:key="id"><view class="member-avatar">{{item.avatar}}</view><view class="member-copy"><text>{{item.name}}</text><small>{{item.subjectText}} · {{item.shortId}}</small></view><view class="member-actions"><button loading="{{managingTeacherId===item.id}}" disabled="{{managingTeacherId}}" data-action="approve" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="manageTeacher">批准</button><button class="danger-text" disabled="{{managingTeacherId}}" data-action="reject" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="manageTeacher">拒绝</button></view></view></view>
    <view class="section-heading"><view><text class="section-title">已加入教师</text><text class="section-note">管理科目、转让班主任或移除成员</text></view><text class="count-badge">{{approvedTeachers.length}}</text></view>
    <view class="surface member-list"><view class="member-row approved" wx:for="{{approvedTeachers}}" wx:key="id"><view class="member-avatar approved-avatar">{{item.avatar}}</view><view class="member-copy"><view><text>{{item.name}}</text><label class="role {{item.isHomeroom?'homeroom':''}}">{{item.isSelf?'我 · ':''}}{{item.role}}</label></view><small>{{item.subjectText}}</small></view><view class="member-actions"><button disabled="{{managingTeacherId}}" data-id="{{item.id}}" data-name="{{item.name}}" data-subjects="{{item.subjectValue}}" bindtap="editSubjects">设置科目</button><button wx:if="{{!item.isSelf && !item.isHomeroom}}" class="transfer-text" loading="{{managingTeacherId===item.id}}" disabled="{{managingTeacherId}}" data-action="transfer" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="manageTeacher">转让班主任</button><button wx:if="{{!item.isSelf && !item.isHomeroom}}" class="danger-text" loading="{{managingTeacherId===item.id}}" disabled="{{managingTeacherId}}" data-action="remove" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="manageTeacher">移除教师</button></view></view></view>
    <view class="member-security-note"><view>✓</view><text>只有班主任可以审核、移除教师或转让班主任身份。转让后，原班主任会保留为普通任课教师。</text></view>
  </block>

  <block wx:elif="{{isHomeroom && tab==='faces'}}">
    <view class="surface face-control-card">
      <view class="face-control-heading"><view class="face-control-icon">识</view><view><text>教室人脸系统</text><small>{{faceSystemEnabled?'正在后台识别并更新出勤':'当前已停止摄像头采集与识别'}}</small></view><switch checked="{{faceSystemEnabled}}" disabled="{{faceControlBusy || !faceLanAvailable}}" color="#07C160" bindchange="toggleFaceSystem"/></view>
      <view class="face-lan-state {{faceLanAvailable?'available':'unavailable'}}"><view></view><text>{{faceLanMessage}}</text><button wx:if="{{!faceLanAvailable}}" bindtap="retryFaceLan">重新连接</button></view>
      <button class="camera-preview-button" disabled="{{!faceLanAvailable || !faceSystemEnabled}}" bindtap="openCameraPreview" hover-class="camera-button-pressed"><view class="camera-button-icon"><view></view></view><view><text>查看完整教室画面</text><small>仅通过当前局域网实时查看，不上传云端、不保存</small></view><text class="camera-arrow">›</text></button>
    </view>
    <view class="face-guide surface"><view class="face-guide-icon">脸</view><view><text>匹配待识别人脸</text><small>请选择学生姓名，确认后教室端会自动识别该学生。</small></view></view>
    <view class="face-grid" wx:if="{{pendingFaces.length}}"><view class="face-card surface" wx:for="{{pendingFaces}}" wx:key="faceId"><image src="{{item.image}}" mode="aspectFill" data-image="{{item.image}}" bindtap="previewFace"></image><text>待匹配人脸 {{index+1}}</text><picker mode="selector" range="{{studentNames}}" data-index="{{index}}" bindchange="matchFace"><button>选择学生并匹配</button></picker></view></view>
    <view class="surface empty" wx:else><view class="empty-mark">✓</view><text class="empty-title">暂无待匹配人脸</text><text class="empty-desc">教室端检测到新的陌生人脸后，会自动显示在这里。</text></view>
  </block>
  <view class="surface teacher-limited-card" wx:if="{{permissionsReady && !isHomeroom}}"><view class="limited-mark">✓</view><text>已作为任课教师加入</text><small>你可以从首页查看出勤和本人授课科目的作业。班级资料、人脸匹配和教师成员由班主任统一管理。</small></view>
</view>

<view class="modal-mask" wx:if="{{batchVisible}}" catchtouchmove="noop"><view class="batch-sheet"><view class="sheet-handle"></view><view class="batch-title"><view><text>批量添加学生</text><small>每行一名，也支持逗号、顿号分隔</small></view><button bindtap="closeBatch">×</button></view><textarea maxlength="10000" value="{{batchText}}" bindinput="onBatchInput" placeholder="在这里粘贴学生姓名，每行一名"></textarea><view class="batch-meta"><text>已识别 {{batchCount}} 名学生</text><text>重复姓名会自动忽略</text></view><button class="primary" bindtap="applyBatch">添加到现有名单</button></view></view>

<view class="camera-viewer" wx:if="{{cameraPreviewVisible}}" catchtouchmove="noop">
  <view class="camera-viewer-head"><view><text>教室实时画面</text><small>{{cameraStatus}}</small></view><button bindtap="closeCameraPreview" aria-label="关闭摄像头画面">×</button></view>
  <view class="camera-stage"><image wx:if="{{cameraFrame}}" src="{{cameraFrame}}" mode="aspectFit"></image><view class="camera-loading" wx:else><view class="camera-pulse"></view><text>{{cameraStatus}}</text><small>正在等待教室端发送画面</small></view></view>
  <view class="camera-privacy"><view>盾</view><text>画面只在手机与教室电脑之间通过局域网传输，关闭页面后立即停止推送。</text></view>
</view>

<view class="setup-overlay" wx:if="{{onboarding}}" catchtouchmove="noop"><view class="setup-shell"><view class="setup-brand"><view>班</view><text>班主任首次配置</text></view><view class="setup-progress"><view class="{{onboardingStep>=1?'done':''}}"><view class="step-number">1</view><text>班级信息</text></view><view class="progress-line {{onboardingStep>=2?'done':''}}"></view><view class="{{onboardingStep>=2?'done':''}}"><view class="step-number">2</view><text>学生名单</text></view></view><view class="setup-card" wx:if="{{onboardingStep===1}}"><text class="setup-kicker">第一步</text><text class="setup-title">先设置你的班级</text><text class="setup-desc">班级名称会显示在教师端、小程序和教室大屏中，后续仍可随时修改。</text><text class="form-label">班级名称</text><input class="field setup-input" maxlength="40" value="{{className}}" bindinput="onClassNameInput" placeholder="例如：八年级一班" focus/><button class="primary setup-primary" bindtap="nextSetupStep">下一步</button></view><view class="setup-card student-setup-card" wx:else><text class="setup-kicker">第二步</text><text class="setup-title">批量录入学生名单</text><text class="setup-desc">可以直接从表格复制整列姓名。每行一名，也支持逗号或顿号分隔，重复姓名会自动合并。</text><textarea class="setup-textarea" maxlength="10000" value="{{batchText}}" bindinput="onBatchInput" placeholder="在这里粘贴学生姓名，每行一名"></textarea><view class="setup-count"><text>已识别</text><strong>{{batchCount}}</strong><text>名学生</text></view><view class="setup-buttons"><button class="setup-back" bindtap="previousSetupStep">上一步</button><button class="setup-submit" loading="{{saving}}" disabled="{{saving}}" bindtap="completeSetup">保存并启用教室</button></view></view><text class="setup-note">完成基础配置后，教师成员管理和人脸匹配功能才会开放。</text></view></view>
