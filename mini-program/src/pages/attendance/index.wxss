.attendance-summary { padding: 30rpx; }
.summary-top { display: flex; align-items: center; }
.attendance-ring { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 132rpx; height: 132rpx; border-radius: 50%; }
.attendance-ring > view { display: flex; align-items: baseline; justify-content: center; width: 100rpx; height: 100rpx; border-radius: 50%; background: #fff; }
.attendance-ring text:first-child { color: rgba(0, 0, 0, .9); font-size: 40rpx; font-weight: 600; line-height: 100rpx; }
.attendance-ring text:last-child { color: rgba(0, 0, 0, .4); font-size: 21rpx; }
.summary-copy { margin-left: 28rpx; }
.summary-copy > text { display: block; color: rgba(0, 0, 0, .9); font-size: 31rpx; font-weight: 600; }
.summary-copy > text:nth-child(2) { margin-top: 7rpx; color: rgba(0, 0, 0, .45); font-size: 22rpx; font-weight: 400; }
.live-mark { display: flex; align-items: center; margin-top: 14rpx; color: #07c160; font-size: 22rpx; }
.live-mark view { width: 13rpx; height: 13rpx; margin-right: 9rpx; border-radius: 50%; background: #07c160; }
.live-mark text { font-size: 22rpx; }
.summary-stats { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 30rpx; padding-top: 26rpx; border-top: 1rpx solid rgba(0, 0, 0, .08); }
.summary-stats view { text-align: center; }.summary-stats view + view { border-left: 1rpx solid rgba(0, 0, 0, .08); }
.summary-stats text { display: block; color: rgba(0, 0, 0, .9); font-size: 32rpx; font-weight: 600; }.summary-stats text:last-child { margin-top: 8rpx; color: rgba(0, 0, 0, .45); font-size: 21rpx; font-weight: 400; }
.pending-alert { display: flex; align-items: flex-start; margin-top: 20rpx; padding: 22rpx 24rpx; border-radius: 16rpx; background: #fff5e8; }
.alert-icon { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; margin-right: 16rpx; border-radius: 50%; background: #fa9d3b; color: #fff; font-size: 24rpx; font-weight: 600; }
.pending-alert text { display: block; color: #a65f00; font-size: 25rpx; font-weight: 500; }.pending-alert text:last-child { margin-top: 5rpx; font-size: 21rpx; font-weight: 400; opacity: .8; }
.face-section { width: calc(100% + 64rpx); margin: 0 -32rpx; }
.face-section .section-heading { padding: 0 32rpx; }.section-count { color: rgba(0, 0, 0, .4); font-size: 22rpx; }
.face-strip { display: flex; gap: 16rpx; padding: 0 32rpx 4rpx; }
.face-card { flex: 0 0 auto; width: 168rpx; overflow: hidden; border-radius: 16rpx; background: #fff; }
.face-card image { display: block; width: 168rpx; height: 152rpx; background: #ededed; }
.face-caption { display: flex; align-items: center; min-width: 0; height: 58rpx; padding: 0 14rpx; }
.face-caption text { overflow: hidden; color: rgba(0, 0, 0, .7); font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.face-state { flex: 0 0 auto; width: 11rpx; height: 11rpx; margin-right: 8rpx; border-radius: 50%; background: #fa9d3b; }.face-state.recognized { background: #07c160; }
.student-heading { margin-top: 44rpx; }
.filter-tabs { display: grid; grid-template-columns: repeat(4, 1fr); padding: 8rpx; }
.filter-tab { display: flex; align-items: center; justify-content: center; min-height: 66rpx; border-radius: 12rpx; color: rgba(0, 0, 0, .55); font-size: 22rpx; }
.filter-tab.active { background: #e9f8ef; color: #07c160; font-weight: 600; }
.student-search { margin-top: 18rpx; }
.attendance-list { margin-top: 18rpx; }
.attendance-cell { display: flex; align-items: center; min-height: 112rpx; padding: 18rpx 24rpx; }.attendance-cell + .attendance-cell { border-top: 1rpx solid rgba(0, 0, 0, .08); }
.student-avatar { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; overflow: hidden; border-radius: 50%; background: #f2f2f2; color: rgba(0, 0, 0, .55); font-size: 25rpx; font-weight: 600; }.student-avatar.present { background: #e9f8ef; color: #07c160; }.student-avatar.away { background: #fff5e8; color: #b06000; }.student-avatar image { width: 100%; height: 100%; }
.student-copy { flex: 1; min-width: 0; margin-left: 20rpx; }.student-copy text { display: block; color: rgba(0, 0, 0, .9); font-size: 28rpx; font-weight: 500; }.student-copy text:last-child { margin-top: 6rpx; color: rgba(0, 0, 0, .45); font-size: 21rpx; font-weight: 400; }
.attendance-state { display: flex; align-items: center; height: 48rpx; padding: 0 16rpx; border-radius: 24rpx; background: #f2f2f2; color: rgba(0, 0, 0, .5); font-size: 21rpx; }.attendance-state view { width: 11rpx; height: 11rpx; margin-right: 8rpx; border-radius: 50%; background: #b2b2b2; }.attendance-state.present { background: #e9f8ef; color: #07c160; }.attendance-state.present view { background: #07c160; }.attendance-state.away { background: #fff5e8; color: #b06000; }.attendance-state.away view { background: #fa9d3b; }
.attendance-page > .empty { margin-top: 18rpx; }
