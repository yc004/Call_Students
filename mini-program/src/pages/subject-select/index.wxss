.subject-page{box-sizing:border-box;min-height:100vh;padding:36rpx 32rpx calc(190rpx + env(safe-area-inset-bottom));background:#f5f5f5;color:#191919}.intro{display:flex;flex-direction:column;padding:12rpx 8rpx 30rpx}.kicker{color:#07a34f;font-size:24rpx;font-weight:600}.title{margin-top:10rpx;font-size:42rpx;font-weight:650}.description{margin-top:12rpx;color:#777;font-size:24rpx;line-height:1.55}.subject-list{display:block;overflow:hidden;border-radius:24rpx;background:#fff}.subject-row{display:flex;box-sizing:border-box;min-height:94rpx;align-items:center;justify-content:space-between;padding:0 28rpx;font-size:29rpx}.subject-row+ .subject-row{border-top:1rpx solid #ededed}.subject-row checkbox{transform:scale(.88)}.bottom-bar{position:fixed;right:0;bottom:0;left:0;box-sizing:border-box;padding:18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));border-top:1rpx solid rgba(0,0,0,.08);background:rgba(255,255,255,.96)}.selection-count{margin-bottom:14rpx;color:#777;font-size:23rpx}.selection-count text{color:#07a34f;font-weight:600}.actions{display:flex;gap:18rpx}.actions button{height:82rpx;margin:0;border-radius:16rpx;font-size:28rpx;font-weight:600;line-height:82rpx}.actions button::after{border:0}.cancel{width:190rpx;background:#f2f2f2;color:#333}.confirm{flex:1;background:#07c160;color:#fff}@media(prefers-color-scheme:dark){.subject-page{background:#111;color:rgba(255,255,255,.92)}.description,.selection-count{color:rgba(255,255,255,.52)}.subject-list{background:#1e1e1e}.subject-row+.subject-row{border-color:rgba(255,255,255,.1)}.bottom-bar{border-color:rgba(255,255,255,.1);background:rgba(30,30,30,.96)}.cancel{background:#2c2c2c;color:rgba(255,255,255,.9)}}
