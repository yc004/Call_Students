page {
  min-height: 100%;
  background: #f5f5f5;
  color: rgba(0, 0, 0, .9);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view, text, button, input, textarea, picker { box-sizing: border-box; }
button::after { border: 0; }

.page {
  min-height: 100vh;
  padding: 24rpx 32rpx calc(150rpx + env(safe-area-inset-bottom));
  animation: page-in .16s ease-out both;
}

@keyframes page-in {
  from { opacity: .72; transform: translateY(4rpx); }
  to { opacity: 1; transform: none; }
}

.page-toolbar {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  min-height: 96rpx;
  padding-bottom: 16rpx;
}

.page-heading { min-width: 0; }
.page-kicker { display: block; color: rgba(0, 0, 0, .5); font-size: 24rpx; line-height: 1.4; }
.page-title { display: block; overflow: hidden; margin-top: 4rpx; color: rgba(0, 0, 0, .9); font-size: 40rpx; font-weight: 600; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }

.surface { overflow: hidden; border-radius: 20rpx; background: #fff; }
.section-heading { display: flex; align-items: flex-end; justify-content: space-between; margin: 40rpx 8rpx 16rpx; }
.section-title { display: block; color: rgba(0, 0, 0, .9); font-size: 30rpx; font-weight: 600; }
.section-note { display: block; margin-top: 6rpx; color: rgba(0, 0, 0, .45); font-size: 22rpx; line-height: 1.45; }

.primary, .secondary, .danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  margin: 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 88rpx;
}
.primary { background: #07c160; color: #fff; }
.primary[disabled] { background: #a9dfbf; color: rgba(255, 255, 255, .9); }
.secondary { background: #f2f2f2; color: rgba(0, 0, 0, .9); }
.danger-button { background: #fff; color: #fa5151; }

.header-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  height: 64rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 12rpx;
  background: #fff;
  color: rgba(0, 0, 0, .7);
  font-size: 25rpx;
  font-weight: 500;
  line-height: 64rpx;
}

.field, .picker-field, .assignment-input {
  width: 100%;
  border: 1rpx solid rgba(0, 0, 0, .12);
  border-radius: 12rpx;
  background: #fff;
  color: rgba(0, 0, 0, .9);
  font-size: 28rpx;
}
.field, .picker-field { height: 88rpx; padding: 0 24rpx; }
.picker-field { display: flex; align-items: center; justify-content: space-between; }
.label { display: block; margin: 30rpx 0 14rpx; color: rgba(0, 0, 0, .9); font-size: 27rpx; font-weight: 500; }

.connection-pill { display: flex; align-items: center; max-width: 420rpx; height: 52rpx; padding: 0 18rpx; border-radius: 26rpx; background: #fff; color: rgba(0, 0, 0, .55); font-size: 22rpx; }
.connection-pill text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.status-dot { flex: 0 0 auto; width: 14rpx; height: 14rpx; margin-right: 12rpx; border-radius: 50%; background: #b2b2b2; }
.status-dot.online { background: #07c160; }
.status-dot.connecting, .status-dot.waiting { background: #fa9d3b; }

.search-box { display: flex; align-items: center; height: 72rpx; padding: 0 20rpx; border-radius: 12rpx; background: #ededed; }
.search-icon { position: relative; width: 24rpx; height: 24rpx; margin-right: 16rpx; border: 3rpx solid #8a8a8a; border-radius: 50%; }
.search-icon::after { position: absolute; right: -8rpx; bottom: -6rpx; width: 10rpx; height: 3rpx; border-radius: 2rpx; background: #8a8a8a; content: ""; transform: rotate(45deg); }
.search-box input { flex: 1; height: 72rpx; color: rgba(0, 0, 0, .9); font-size: 28rpx; }
.search-clear { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; color: rgba(0, 0, 0, .35); font-size: 32rpx; }

.empty { padding: 88rpx 40rpx; text-align: center; }
.empty-mark { display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; margin: 0 auto 28rpx; border-radius: 50%; background: #e9f8ef; color: #07c160; font-size: 40rpx; font-weight: 600; }
.empty-title { display: block; color: rgba(0, 0, 0, .9); font-size: 30rpx; font-weight: 600; }
.empty-desc { display: block; margin-top: 12rpx; color: rgba(0, 0, 0, .45); font-size: 25rpx; line-height: 1.6; }

.bottom-sheet { width: 100%; max-height: 88vh; overflow: auto; padding: 14rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); background: #fff; }
.sheet-handle { width: 72rpx; height: 8rpx; margin: 0 auto 26rpx; border-radius: 4rpx; background: #d8d8d8; }
.sheet-title { display: flex; align-items: center; justify-content: space-between; color: rgba(0, 0, 0, .9); font-size: 34rpx; font-weight: 600; }
.sheet-title > view { display: flex; flex-direction: column; }
.sheet-subtitle { margin-top: 6rpx; color: rgba(0, 0, 0, .45); font-size: 23rpx; font-weight: 400; }
.sheet-close { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: 50%; background: #f2f2f2; color: rgba(0, 0, 0, .55); font-size: 38rpx; font-weight: 400; }

/* 微信小程序深色模式：跟随系统主题，保持分层背景与可读对比度。 */
@media (prefers-color-scheme: dark) {
  page { background: #111111; color: rgba(255,255,255,.9); }
  .page, .login-page, .profile-page { background: #111111; color: rgba(255,255,255,.9); }
  .surface, .bottom-sheet, .scan-panel, .weui-cells { background: #1e1e1e; }
  .page-kicker, .section-note, .empty-desc, .sheet-subtitle { color: rgba(255,255,255,.55); }
  .page-title, .section-title, .empty-title, .label, .sheet-title { color: rgba(255,255,255,.92); }
  .header-action, .secondary { background: #2a2a2a; color: rgba(255,255,255,.88); }
  .field, .picker-field, .assignment-input { border-color: rgba(255,255,255,.14); background: #242424; color: rgba(255,255,255,.92); }
  .connection-pill { background: #242424; color: rgba(255,255,255,.6); }
  .search-box { background: #292929; }.search-box input { color: rgba(255,255,255,.9); }.search-icon { border-color:#999; }.search-icon::after { background:#999; }
  .search-clear { color: rgba(255,255,255,.45); }
  .empty-mark { background: #173a29; color: #35d67c; }.sheet-handle { background:#555; }.sheet-close { background:#2c2c2c; color:rgba(255,255,255,.65); }
  button { color: inherit; }
}
