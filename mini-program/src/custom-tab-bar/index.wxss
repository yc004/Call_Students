.custom-tabbar { position:fixed; right:0; bottom:0; left:0; z-index:999; padding-bottom:env(safe-area-inset-bottom); border-top:1rpx solid rgba(0,0,0,.12); background:rgba(255,255,255,.96); }
.tabbar-inner { display:flex; height:104rpx; align-items:center; justify-content:space-around; }
.tab-item { display:flex; height:100%; flex:1; flex-direction:column; align-items:center; justify-content:center; color:#7a7e83; font-size:20rpx; }
.tab-item > image { width:52rpx; height:52rpx; margin-bottom:2rpx; }.tab-item.selected { color:#07c160; }
.scan-ring { display:flex; width:72rpx; height:72rpx; align-items:center; justify-content:center; margin-top:-24rpx; margin-bottom:1rpx; border:6rpx solid #fff; border-radius:50%; background:#07c160; box-shadow:0 8rpx 20rpx rgba(7,193,96,.28); }.scan-ring image { width:45rpx;height:45rpx;filter:brightness(0) invert(1); }
@media (prefers-color-scheme:dark) { .custom-tabbar { border-color:rgba(255,255,255,.12);background:rgba(30,30,30,.97); }.scan-ring { border-color:#1e1e1e; } }
