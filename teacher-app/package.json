{
  "name": "teacher-app",
  "version": "1.0.0",
  "description": "教师端 —— 呼叫控制台",
  "main": "main.js",
  "scripts": {
    "start": "unset ELECTRON_RUN_AS_NODE && electron .",
    "verify:syntax": "node ../scripts/verify-js-syntax.js teacher-app",
    "test:account": "node test/account-auth.test.js",
    "build": "electron-builder --win",
    "build:win:ci": "electron-builder --win nsis --x64 --publish never",
    "build:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.schoolcall.teacher",
    "productName": "教室呼叫-教师端",
    "executableName": "ClassroomCall-Teacher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "account-auth.js",
      "preload.js",
      "index.html",
      "style.css",
      "ui.css",
      "app.js",
      "icon.png",
      "node_modules/**/*",
      "!node_modules/electron/**",
      "!data/*"
    ],
    "win": {
      "icon": "icon.png",
      "artifactName": "ClassroomCall-Teacher-${version}-Setup-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "教室呼叫-教师端"
    }
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
