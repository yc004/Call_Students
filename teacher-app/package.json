{
  "name": "teacher-app",
  "version": "1.0.5",
  "description": "教师端 —— 呼叫控制台",
  "main": "main.js",
  "scripts": {
    "start": "unset ELECTRON_RUN_AS_NODE && electron .",
    "verify:syntax": "node ../scripts/verify-js-syntax.js teacher-app",
    "test:account": "node test/account-auth.test.js",
    "test:pairing": "node test/mini-program-pairing.test.js",
    "test:connection-code": "node test/connection-code.test.js",
    "test:homework-view": "node test/homework-view.test.js",
    "test:homework-export": "node test/homework-export.test.js",
    "test:homework-ai": "node test/homework-ai.test.js",
    "build": "electron-builder --win",
    "build:win:ci": "electron-builder --win nsis --x64 --publish never",
    "prepare:mac-icon": "bash ../scripts/prepare-macos-icon.sh .",
    "build:mac": "npm run prepare:mac-icon && electron-builder --mac dmg zip --config.mac.identity=- --config.mac.hardenedRuntime=false",
    "build:mac:ci": "npm run prepare:mac-icon && electron-builder --mac dmg zip --publish never",
    "build:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.schoolcall.teacher",
    "productName": "班达-教师端",
    "executableName": "Banda-Teacher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "connection-code.js",
      "homework-view.js",
      "homework-export.js",
      "homework-ai.js",
      "error-report.js",
      "mini-program-pairing.js",
      "wechat-direct-link.js",
      "account-auth.js",
      "cloud-client.js",
      "preload.js",
      "index.html",
      "style.css",
      "ui.css",
      "desktop.css",
      "app.js",
      "icon.png",
      "node_modules/**/*",
      "!node_modules/electron/**",
      "!data/*"
    ],
    "win": {
      "icon": "icon.png",
      "artifactName": "Banda-Teacher-${version}-Setup-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "artifactName": "Banda-Teacher-${version}-macOS-${arch}.${ext}",
      "category": "public.app-category.education",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "班达-教师端"
    }
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "qrcode": "^1.5.4"
  }
}
