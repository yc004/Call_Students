{
  "name": "classroom-app",
  "version": "1.0.3",
  "description": "教室端 —— 大屏呼叫显示",
  "main": "main.js",
  "scripts": {
    "start": "unset ELECTRON_RUN_AS_NODE && electron .",
    "verify:syntax": "node ../scripts/verify-js-syntax.js classroom-app",
    "test:qr": "node test/classroom-qr.test.js",
    "prepare:models": "node scripts/prepare-native-models.js",
    "verify:models": "node scripts/prepare-native-models.js --verify-only",
    "build:native": "npm run verify:models && cmake-js build --directory native",
    "build:native:clean": "cmake-js clean --directory native",
    "test:native": "node native/test/test_bindings.js && node native/test/test_gallery.js",
    "build": "npm run build:native && electron-builder --win",
    "build:win:ci": "electron-builder --win nsis --x64 --publish never",
    "prepare:mac-icon": "bash ../scripts/prepare-macos-icon.sh .",
    "build:mac": "npm run build:native && npm run prepare:mac-icon && electron-builder --mac dmg zip --config.mac.identity=- --config.mac.hardenedRuntime=false",
    "build:mac:ci": "npm run prepare:mac-icon && electron-builder --mac dmg zip --publish never",
    "build:portable": "npm run build:native && electron-builder --win portable"
  },
  "cmake-js": {
    "runtime": "electron",
    "runtimeVersion": "42.4.0"
  },
  "build": {
    "appId": "com.schoolcall.classroom",
    "productName": "教室呼叫-教室端",
    "executableName": "ClassroomCall-Classroom",
    "afterPack": "scripts/verify-packaged-native.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "connection-code.js",
      "lan-addresses.js",
      "classroom-qr.js",
      "classroom-mdns.js",
      "cloud-config.js",
      "cloud-bridge.js",
      "preload.js",
      "face-gallery.js",
      "icon.png",
      "renderer/**/*",
      "models/**/*",
      "!models/onnx/**",
      "node_modules/**/*",
      "!node_modules/electron/**",
      "!data/*"
    ],
    "extraResources": [
      {
        "from": "native/build/Release",
        "to": "native",
        "filter": [
          "*.node",
          "*.dll",
          "*.dylib",
          "*.so"
        ]
      },
      {
        "from": "models/onnx",
        "to": "models/onnx",
        "filter": [
          "*.onnx",
          "models.json"
        ]
      }
    ],
    "asarUnpack": [
      "native/build/Release/*.node",
      "native/build/Release/*.dll",
      "native/build/Release/*.dylib",
      "native/build/Release/*.so"
    ],
    "win": {
      "icon": "icon.png",
      "artifactName": "ClassroomCall-Classroom-${version}-Setup-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "artifactName": "ClassroomCall-Classroom-${version}-macOS-${arch}.${ext}",
      "category": "public.app-category.education",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "教室呼叫-教室端"
    }
  },
  "devDependencies": {
    "cmake-js": "^7.3.0",
    "electron": "42.4.0",
    "electron-builder": "26.15.3",
    "node-addon-api": "^8.3.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "bonjour-service": "^1.3.0",
    "face-api.js": "^0.22.2",
    "qrcode": "1.5.4",
    "ws": "^8.16.0"
  }
}
